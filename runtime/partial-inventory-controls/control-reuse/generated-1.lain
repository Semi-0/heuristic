(define stock1 (ttms-premise-closure (network [b n d] (/ (* (* b n) (- 100 d)) 100)) shared-rule))
(define total1 ((ttms-premise-closure (ttms-premise-closure (network [b n] (* b n)) shared-rule) question-1) boxes-1 items-per-box-1))
(-> total1 observed-total-1)
(define usable1 ((ttms-premise-closure stock1 question-1) boxes-1 items-per-box-1 damage-percent-1))
(define margin1 (- usable1 order-quantity-1))
(define fill1 (>= margin1 0))
(-> usable1 observed-usable-1)
(-> margin1 observed-margin-1)
(-> fill1 observed-fulfillment-1)
(-> (str "Total=" total1 "; damage unknown; usable and fulfillment unresolved.") user-output-1)
