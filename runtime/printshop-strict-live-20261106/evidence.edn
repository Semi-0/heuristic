btotal) result-2)\\n       (+ ((slot :production) result-2) ((slot :rush) result-2)\\n          (- ((slot :discount) result-2)) ((slot :setup-fee) pricing)))\\n    (= ((slot :delivery) result-2)\\n       (select (>= ((slot :subtotal) result-2) ((slot :free-delivery-threshold) pricing))\\n               0 ((slot :delivery-fee) pricing)))\\n    (= ((slot :tax) result-2)\\n       (* (+ ((slot :subtotal) result-2) ((slot :delivery) result-2))\\n          ((slot :tax-rate) pricing)))\\n    (= ((slot :total) result-2)\\n       (round-money (+ ((slot :subtotal) result-2) ((slot :delivery) result-2) ((slot :tax) result-2))))\\n    (>= ((slot :subtotal) result-2) ((slot :free-delivery-threshold) pricing))\\n    (= ((slot :discount) result-2) ((slot :discount-cap) order-2))))\\n\\n(-> check-2 self-check-2)\" \"\\n\\n(define result-3 (compute-quote-1 order-3 pricing))\\n\\n(-> ((slot :production) result-3) ((slot :production) quote-3))\\n(-> ((slot :rush) result-3) ((slot :rush) quote-3))\\n(-> ((slot :discount) result-3) ((slot :discount) quote-3))\\n(-> ((slot :subtotal) result-3) ((slot :subtotal) quote-3))\\n(-> ((slot :delivery) result-3) ((slot :delivery) quote-3))\\n(-> ((slot :tax) result-3) ((slot :tax) quote-3))\\n(-> ((slot :total) result-3) ((slot :total) quote-3))\\n\\n(-> (str \\\"Quote for \\\" ((slot :quantity) order-3) \\\" copies (member, standard service):\\\\n\\\"\\n         \\\"  Production: $\\\" ((slot :production) result-3) \\\"\\\\n\\\"\\n         \\\"  Rush: $\\\" ((slot :rush) result-3) \\\"\\\\n\\\"\\n         \\\"  Discount: $\\\" ((slot :discount) result-3) \\\"\\\\n\\\"\\n         \\\"  Subtotal (incl. setup): $\\\" ((slot :subtotal) result-3) \\\"\\\\n\\\"\\n         \\\"  Delivery: $\\\" ((slot :delivery) result-3) \\\"\\\\n\\\"\\n         \\\"  Tax (8%): $\\\" ((slot :tax) result-3) \\\"\\\\n\\\"\\n         \\\"  Total: $\\\" ((slot :total) result-3))\\n    user-output-3)\\n\\n(define check-3\\n  (and\\n    (= ((slot :production) result-3)\\n 