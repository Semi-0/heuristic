(define q3 ((ttms-premise-closure quote-fn question-3) order-3 pricing))
(-> ((slot :production) q3) ((slot :production) quote-3))
(-> ((slot :rush) q3) ((slot :rush) quote-3))
(-> ((slot :discount) q3) ((slot :discount) quote-3))
(-> ((slot :subtotal) q3) ((slot :subtotal) quote-3))
(-> ((slot :delivery) q3) ((slot :delivery) quote-3))
(-> ((slot :tax) q3) ((slot :tax) quote-3))
(-> ((slot :total) q3) ((slot :total) quote-3))
(-> (str "Total: " ((slot :total) q3)) user-output-3)
(-> (= ((slot :total) q3) (round-money (+ ((slot :subtotal) q3) ((slot :delivery) q3) ((slot :tax) q3)))) self-check-3)
