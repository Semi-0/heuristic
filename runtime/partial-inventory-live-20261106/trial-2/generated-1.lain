

(define compute-total-1 (ttms-premise-closure (network [b ipb] (* b ipb)) shared-rule))
(define compute-usable-1 (ttms-premise-closure (network [total dp] (* total (- 1 (/ dp 100)))) shared-rule))
(define compute-margin-1 (ttms-premise-closure (network [usable oq] (- usable oq)) shared-rule))
(define compute-fulfillment-1 (ttms-premise-closure (network [usable oq] (>= usable oq)) shared-rule))
(define total-1 (compute-total-1 boxes-1 items-per-box-1))
(define usable-1 (compute-usable-1 total-1 damage-percent-1))
(define margin-1 (compute-margin-1 usable-1 order-quantity-1))
(define fulfillment-1 (compute-fulfillment-1 usable-1 order-quantity-1))
(-> total-1 observed-total-1)
(-> usable-1 observed-usable-1)
(-> margin-1 observed-margin-1)
(-> fulfillment-1 observed-fulfillment-1)
(-> (str "Total items are computable now: 20 boxes times 12 items per box gives 240. Usable stock, margin, and fulfillment remain unresolved because damage-percent-1 has not been reported. Once damage-percent-1 is supplied, usable-1, margin-1, and fulfillment-1 will propagate automatically through the network.") user-output-1)