

(define quote-result-3 (compute-quote quantity-3 rush-3 member-3 discount-cap-3))

(-> ((slot :production) quote-3) ((slot :production) quote-result-3))
(-> ((slot :rush) quote-3) ((slot :rush) quote-result-3))
(-> ((slot :discount) quote-3) ((slot :discount) quote-result-3))
(-> ((slot :subtotal) quote-3) ((slot :subtotal) quote-result-3))
(-> ((slot :delivery) quote-3) ((slot :delivery) quote-result-3))
(-> ((slot :tax) quote-3) ((slot :tax) quote-result-3))
(-> ((slot :total) quote-3) ((slot :total) quote-result-3))

(-> user-output-3
  (str "Quote for " quantity-3 " copies (standard, member):\n"
       "  Production: $" ((slot :production) quote-result-3) "\n"
       "  Rush charge: $" ((slot :rush) quote-result-3) "\n"
       "  Discount: $" ((slot :discount) quote-result-3) "\n"
       "  Subtotal (incl. setup): $" ((slot :subtotal) quote-result-3) "\n"
       "  Delivery: $" ((slot :delivery) quote-result-3) "\n"
       "  Tax: $" ((slot :tax) quote-result-3) "\n"
       "  Total: $" ((slot :total) quote-result-3)))

(-> self-check-3
  (let [prod ((slot :production) quote-result-3)
        rush ((slot :rush) quote-result-3)
        disc ((slot :discount) quote-result-3)
        sub ((slot :subtotal) quote-result-3)
        del ((slot :delivery) quote-result-3)
        tax ((slot :tax) quote-result-3)
        tot ((slot :total) quote-result-3)]
    (and (= prod (+ (* 100 tier-one-price) (* 400 tier-two-price) (* 220 tier-three-price)))
         (= rush 0)
         (= disc (min (* member-rate prod) discount-cap-3))
         (= sub (+ (- prod disc) setup-fee))
         (= del (select (>= sub free-delivery-threshold) 0 delivery-fee))
         (= tax (* tax-rate (+ sub del)))
         (= tot (round-money (+ sub del tax))))))