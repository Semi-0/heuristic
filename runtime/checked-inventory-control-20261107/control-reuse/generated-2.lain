(define total2 ((ttms-premise-closure (ttms-premise-closure (network [b n] (* b n)) shared-rule) question-2) boxes-2 items-per-box-2))
(-> total2 observed-total-2)
(define usable2 ((ttms-premise-closure stock1 question-2) boxes-2 items-per-box-2 damage-percent-2))
(define margin2 (- usable2 order-quantity-2))
(define fill2 (>= margin2 0))
(-> usable2 observed-usable-2)
(-> margin2 observed-margin-2)
(-> fill2 observed-fulfillment-2)
(-> (str "Usable=" usable2 "; margin=" margin2 "; fulfillment=" fill2) user-output-2)
(define concrete-check2 (and (= (stock1 1 10 0) 10) (= (stock1 1 10 100) 0)))
(-> concrete-check2 case-check-2)
(-> (>= total2 usable2) live-check-2)
(-> (str "Complete cases: zero damage gives 10; all damaged gives 0; verdict=" concrete-check2) test-report-2)
