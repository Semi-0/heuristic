(define q2 ((ttms-premise-closure quote-fn question-2) order-2 pricing))
(-> ((slot :production) q2) ((slot :production) quote-2))
(-> ((slot :rush) q2) ((slot :rush) quote-2))
(-> ((slot :discount) q2) ((slot :discount) quote-2))
(-> ((slot :subtotal) q2) ((slot :subtotal) quote-2))
(-> ((slot :delivery) q2) ((slot :delivery) quote-2))
(-> ((slot :tax) q2) ((slot :tax) quote-2))
(-> ((slot :total) q2) ((slot :total) quote-2))
(-> (str "Total: " ((slot :total) q2)) user-output-2)
(-> (= ((slot :total) q2) (round-money (+ ((slot :subtotal) q2) ((slot :delivery) q2) ((slot :tax) q2)))) self-check-2)
