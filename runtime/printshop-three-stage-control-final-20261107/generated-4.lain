(define q4 ((ttms-premise-closure quote-fn question-4) order-4 pricing))
(-> ((slot :production) q4) ((slot :production) quote-4))
(-> ((slot :rush) q4) ((slot :rush) quote-4))
(-> ((slot :discount) q4) ((slot :discount) quote-4))
(-> ((slot :subtotal) q4) ((slot :subtotal) quote-4))
(-> ((slot :delivery) q4) ((slot :delivery) quote-4))
(-> ((slot :tax) q4) ((slot :tax) quote-4))
(-> ((slot :total) q4) ((slot :total) quote-4))
(-> (str "Total: " ((slot :total) q4)) user-output-4)
(-> (= ((slot :total) q4) (round-money (+ ((slot :subtotal) q4) ((slot :delivery) q4) ((slot :tax) q4)))) self-check-4)
