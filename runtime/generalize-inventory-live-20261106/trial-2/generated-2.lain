

(define total-2 (ttms-premise-closure (* boxes-2 items-per-box-2) shared-rule))
(define usable-2 (ttms-premise-closure (* total-2 (- 1 (/ damage-percent-2 100))) shared-rule))
(define margin-2 (ttms-premise-closure (- usable-2 order-quantity-2) shared-rule))
(define fulfillment-2 (ttms-premise-closure (>= usable-2 order-quantity-2) shared-rule))
(-> total-2 observed-total-2)
(-> usable-2 observed-usable-2)
(-> margin-2 observed-margin-2)
(-> fulfillment-2 observed-fulfillment-2)
(-> (str "Total items: " total-2 " (15 boxes x 24 items). Inspection confirms " damage-percent-2 "% damaged, so usable stock is " usable-2 " items. The order requires " order-quantity-2 " items, leaving a shortage of " (- 0 margin-2) " items. This shipment cannot fulfill the order.") user-output-2)