{:kind :reply, :text "```lain\n(define history (behavior:source))\n(define user-events (behavior:source))\n(define assistant-events (behavior:source))\n\n(-> user-ingress user-events)\n\n(define reply-fn (network [id time content]\n  (let [ack (message-to-user (data:record :id id :time time :role \"assistant\" :content content))]\n    (-> ack assistant-events)\n    ack)))\n\n(define history-updated (behavior:scan history (network [acc event]\n  (let [role (data:get :role event)\n        content (data:get :content event)\n        id (data:get :id event)\n        time (data:get :time event)]\n    (seq:append acc (data:record :role role :content content :id id :time time)))) []))\n\n(-> user-events history-updated)\n(-> assistant-events history-updated)\n\n(define model-request (network [user-event]\n  (let [user-id (data:get :id user-event)\n        user-time (data:get :time user-event)\n        user-content (data:get :content user-event)\n        current-history (behavior:latest-value history-updated)\n        system-msg (data:record :role \"system\" :content \"You are a Lain assistant. Reply with executable Lain code that calls (reply-fn id time content) where id is a new unique string, time is user-time + 1, and content is your response.\")\n        messages (seq:append (seq:map :role current-history) system-msg)\n        request (data:record :id (text:format \"req-%s\" user-id) :messages messages)]\n    (model:request request))))\n\n(-> user-events model-request)\n\n(define model-response (behavior:source))\n(-> model-response (network [resp]\n  (let [id (data:get :id resp)\n        time (data:get :time resp)\n        content (data:get :content resp)]\n    (reply-fn id time content))))\n```", :thinking "", :finish-reason "stop", :truncated? false}