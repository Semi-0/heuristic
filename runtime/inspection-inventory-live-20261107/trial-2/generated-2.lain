

(define total-2 (* boxes-2 items-per-box-2))
(define usable-2 (* total-2 (- 1 (/ damage-percent-2 100))))
(define margin-2 (- usable-2 order-quantity-2))
(define fulfillment-2 (>= usable-2 order-quantity-2))
(-> total-2 observed-total-2)
(-> usable-2 observed-usable-2)
(-> margin-2 observed-margin-2)
(-> fulfillment-2 observed-fulfillment-2)
(define answer-2 (ttms-premise-closure (network [] (str "The shipment has " total-2 " total items. With " damage-percent-2 "% damaged, the usable stock is " usable-2 " items. The order requires " order-quantity-2 " items, so the margin is " margin-2 " items. Since usable stock is less than the order quantity, this shipment cannot fulfill the order; there is a shortage of " (- order-quantity-2 usable-2) " items.")) question-2))
(-> (answer-2) user-output-2)