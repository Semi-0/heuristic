

(define total-items (* boxes-1 items-per-box-1))
(define usable-items (* total-items (- 1 (/ damage-percent-1 100))))
(define margin (- usable-items order-quantity-1))
(define fulfillment (>= usable-items order-quantity-1))
(-> total-items observed-total-1)
(-> usable-items observed-usable-1)
(-> margin observed-margin-1)
(-> fulfillment observed-fulfillment-1)
(define test-usable (network [dp] (* (* boxes-1 items-per-box-1) (- 1 (/ dp 100)))))
(define test-fulfillment (network [dp] (>= (* (* boxes-1 items-per-box-1) (- 1 (/ dp 100))) order-quantity-1)))
(define case-a (= (test-usable 0) 240))
(define case-b (= (test-usable 50) 120))
(define case-c (= (test-usable 100) 0))
(define case-d (test-fulfillment 0))
(define case-e (<= (test-usable 50) order-quantity-1))
(define case-check-1-value (and case-a case-b case-c case-d case-e))
(-> case-check-1-value case-check-1)
(define live-check-1-value (= total-items (* 20 12)))
(-> live-check-1-value live-check-1)
(define test-report-1-text (str "Case A: dp=0, usable=" (test-usable 0) ", expected 240, verdict=" case-a ". Case B: dp=50, usable=" (test-usable 50) ", expected 120, verdict=" case-b ". Case C: dp=100, usable=" (test-usable 100) ", expected 0, verdict=" case-c ". Case D: dp=0, fulfillment=" (test-fulfillment 0) ", expected true, verdict=" case-d ". Case E: dp=50, usable<=order, verdict=" case-e "."))
(-> test-report-1-text test-report-1)
(-> (str "Total items in shipment: " total-items ". Usable stock and fulfillment depend on damage-percent-1 which has not been reported yet. Once damage-percent-1 is supplied, usable = total * (1 - damage/100), margin = usable - order-quantity, and fulfillment = usable >= order-quantity will be determined.") user-output-1)