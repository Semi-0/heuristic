

(.
(define total-1 (* boxes-1 items-per-box-1))
(define usable-calc (network [dp] (* (* boxes-1 items-per-box-1) (- 1 (/ dp 100)))))
(define margin-calc (network [dp] (- (usable-calc dp) order-quantity-1)))
(define fulfillment-calc (network [dp] (>= (usable-calc dp) order-quantity-1)))
(define usable-1 (usable-calc damage-percent-1))
(define margin-1 (margin-calc damage-percent-1))
(define fulfillment-1 (fulfillment-calc damage-percent-1))
(-> total-1 observed-total-1)
(-> usable-1 observed-usable-1)
(-> margin-1 observed-margin-1)
(-> fulfillment-1 observed-fulfillment-1)
(define test-usable-0 (= (usable-calc 0) 240))
(define test-usable-50 (= (usable-calc 50) 120))
(define test-usable-100 (= (usable-calc 100) 0))
(define test-margin-0 (= (margin-calc 0) 40))
(define test-margin-50 (= (margin-calc 50) -80))
(define test-margin-100 (= (margin-calc 100) -200))
(define test-fulfill-0 (fulfillment-calc 0))
(define test-fulfill-50 (not (fulfillment-calc 50)))
(define test-fulfill-100 (not (fulfillment-calc 100)))
(define case-check-1-value (and test-usable-0 test-usable-50 test-usable-100 test-margin-0 test-margin-50 test-margin-100 test-fulfill-0 test-fulfill-50 test-fulfill-100))
(-> case-check-1-value case-check-1)
(define live-check-1-value (>= total-1 order-quantity-1))
(-> live-check-1-value live-check-1)
(define test-report-1-value (str "Cases: dp=0 usable=" (usable-calc 0) " margin=" (margin-calc 0) " fulfill=" (fulfillment-calc 0) "; dp=50 usable=" (usable-calc 50) " margin=" (margin-calc 50) " fulfill=" (fulfillment-calc 50) "; dp=100 usable=" (usable-calc 100) " margin=" (margin-calc 100) " fulfill=" (fulfillment-calc 100) ". All checks pass: " case-check-1-value))
(-> test-report-1-value test-report-1)
(-> (str "Total items in shipment: " total-1 " (20 boxes x 12 items). This is fully determined. Usable stock, margin, and fulfillment status remain unknown because damage-percent-1 has not been reported. Once damage-percent-1 is supplied, usable = total * (1 - damage/100), margin = usable - 200, and fulfillment = usable >= 200 will compute automatically. Note: even with zero damage, total (240) exceeds the order (200), so fulfillment is possible but not guaranteed until the damage rate is known.") user-output-1)