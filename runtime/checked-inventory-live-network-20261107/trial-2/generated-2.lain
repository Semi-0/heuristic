

(define total-items-2 (* boxes-2 items-per-box-2))
(define usable-items-2 (* total-items-2 (- 1 (/ damage-percent-2 100))))
(define margin-2 (- usable-items-2 order-quantity-2))
(define fulfillment-2 (>= usable-items-2 order-quantity-2))
(-> total-items-2 observed-total-2)
(-> usable-items-2 observed-usable-2)
(-> margin-2 observed-margin-2)
(-> fulfillment-2 observed-fulfillment-2)
(define test-usable-2 (network [dp] (* (* boxes-2 items-per-box-2) (- 1 (/ dp 100)))))
(define test-fulfillment-2 (network [dp] (>= (* (* boxes-2 items-per-box-2) (- 1 (/ dp 100))) order-quantity-2)))
(define case-a-2 (= (test-usable-2 0) 360))
(define case-b-2 (= (test-usable-2 100) 0))
(define case-c-2 (= (test-usable-2 50) 180))
(define case-d-2 (= (test-usable-2 5) 342))
(define case-e-2 (test-fulfillment-2 0))
(define case-f-2 (<= (test-usable-2 5) (- order-quantity-2 1)))
(define case-check-2-value (and case-a-2 case-b-2 case-c-2 case-d-2 case-e-2 case-f-2))
(-> case-check-2-value case-check-2)
(define live-check-2-value (and (= usable-items-2 342) (= margin-2 (- 342 350))))
(-> live-check-2-value live-check-2)
(define test-report-2-text (str "Case A: dp=0, usable=" (test-usable-2 0) ", expected 360, verdict=" case-a-2 ". Case B: dp=100, usable=" (test-usable-2 100) ", expected 0, verdict=" case-b-2 ". Case C: dp=50, usable=" (test-usable-2 50) ", expected 180, verdict=" case-c-2 ". Case D: dp=5, usable=" (test-usable-2 5) ", expected 342, verdict=" case-d-2 ". Case E: dp=0, fulfillment=" (test-fulfillment-2 0) ", expected true, verdict=" case-e-2 ". Case F: dp=5, usable<=order-1, verdict=" case-f-2 "."))
(-> test-report-2-text test-report-2)
(-> (str "Total items in shipment 2: " total-items-2 ". Usable stock after 5% damage: " usable-items-2 " items. Order quantity: " order-quantity-2 ". Margin (usable minus order): " margin-2 " items. Fulfillment possible: " fulfillment-2 ". The shipment cannot fulfill the order of 350 items; there is a shortage of 8 items.") user-output-2)