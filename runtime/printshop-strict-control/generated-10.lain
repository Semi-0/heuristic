(define q5 ((ttms-premise-closure quote-fn question-5) order-5 pricing))
(-> ((slot :production) q5) ((slot :production) quote-5))
(-> ((slot :rush) q5) ((slot :rush) quote-5))
(-> ((slot :discount) q5) ((slot :discount) quote-5))
(-> ((slot :subtotal) q5) ((slot :subtotal) quote-5))
(-> ((slot :delivery) q5) ((slot :delivery) quote-5))
(-> ((slot :tax) q5) ((slot :tax) quote-5))
(-> ((slot :total) q5) ((slot :total) quote-5))
(-> (str "Total: " ((slot :total) q5)) user-output-5)
(-> (= ((slot :total) q5) (round-money (+ ((slot :subtotal) q5) ((slot :delivery) q5) ((slot :tax) q5)))) self-check-5)
