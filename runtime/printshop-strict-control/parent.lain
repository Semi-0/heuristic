))
(define analysis-request-1 (cell:first (switch (data:record :id "analysis-1" :text (environment:describe generated-environment selected)) analysis-trigger-1)))
(io-model:input ((slot :worker) m) analysis-request-1)
(define request-1 (cell:first (switch (data:record :id "round-1" :text (environment:describe generated-environment selected)) trigger-1)))
(io-model:input ((slot :worker) m) request-1)
