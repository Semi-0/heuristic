(load-lain "model-refined.lain")
(load-lain "lib/behavior-core.lain")

(define m (model))
(define experiment-worker ((slot :worker) m))
(define ask-event)
(define ask (data:get :content ask-event))
(define active-round (data:get :round ask-event))
(define conversation-events (behavior:source))
(-> (event:point (data:get :id ask-event) (data:get :time ask-event) (data:record :role "user" :content ask)) conversation-events)
(define conversation-prefixes (behavior:scan conversation-events seq:append (seq:empty)))
(define conversation-history (behavior:latest-value conversation-prefixes (seq:empty)))
(define source-events (behavior:source))
(define source-prefixes (behavior:scan source-events seq:append (seq:empty)))
(define written-code (behavior:latest-value source-prefixes (seq:empty)))
(define phase)
(define analysis-record)
(define implementation-id)
(define raw-model-result (model:output m))
(define model-result (switch raw-model-result (= (data:get :request-id raw-model-result) implementation-id)))
(-> (event:point (data:get :response-sequence model-result) (data:get :response-sequence model-result) (data:get :text model-result)) source-events)
(define role-cell "Work carefully from the problem and available facts. Follow the strict procedure and the response format for the current phase. The implementation source is admitted into one persistent lexical child.")
(define output-format-cell "Read phase first. In analysis phase, return ONLY one EDN map, no Markdown or executable forms, with nonempty string fields :outputs :facts :unknowns :units :rules :branches :operators :operator :tests, plus :decision equal to :reuse, :adapt, or :construct. Use \"none\" for unknowns or operator when appropriate. :operators must summarize the candidates actually available and their suitability. :operator names the selected existing callable for reuse/adapt or proposed new callable for construct. :tests describes independent tests and what mistakes they could detect. The host checks record completeness and existence of selected reuse/adapt callables, not the correctness of your analysis. In implementation phase, analysis-record contains your unchanged analysis. Return executable Lain source only, without fences. Existing parent ports must be connected, not redefined. order-N and pricing are input structs; quote-N has :production :rush :discount :subtotal :delivery :tax :total. Connect the computed breakdown to those slots, a text reply to user-output-N, and your test outcome to self-check-N. N is the current round. Use Lain operations on inputs, not precomputed answer constants. Only final total is rounded to cents.")
(define context-cell "One worker and lexical child remain alive throughout the questions. Earlier definitions remain available in the binding directory. written-code and history contain actual prior source and user/reply messages. Return new forms for the current ask. You may construct test cases or consistency checks using the available operators and connect a boolean result to self-check-N. The parent supplies no quote formula or solved example.")
(define language-cell "(define name expression) binds a cell. (network [parameters] body) creates a callable. A network body can contain local define forms and return its final expression, including a struct. (struct :key value ...) constructs connected fields. Read a field with ((slot :key) object). Write an existing field with (-> computed-value ((slot :key) output-object)). + - * / min max >= <= = str and round-money are support-aware operations. (select condition then-value else-value) selects a branch. round-money rounds to two decimals, half up; use it only on the final amount. str builds text from connected values. Unknown inputs leave dependent computations unresolved. ttms-premise-closure attaches a premise to a callable; invocation carries it to results. Example: (define f (ttms-premise-closure (network [x] (+ x 2)) some-premise)). inspect:premises accepts (cell:reference binding). The struct operators and primitive documentation are capabilities, not prebuilt pricing solutions.")
(define rules-cell "Fictional print-shop rules: progressive production pricing: first tier-one-limit copies at tier-one-price each; next tier-two-count copies at tier-two-price each; remaining copies at tier-three-price each. Rush service adds rush-rate times production cost. Members receive member-rate times production plus rush charges as discount, capped by the order discount-cap; nonmembers receive no discount. Add setup-fee after discount. Delivery costs delivery-fee, waived when subtotal after discount and setup is at least free-delivery-threshold. Apply tax-rate to the entire amount including delivery. Final total includes tax and is rounded half up to cents; intermediate values are not rounded.")
(define metadata-cell "pricing exposes the shared numeric rules. Every order-N contains independently supported :quantity, :rush? boolean, :member? boolean, :discount-cap, and :question premise. question premises identify the corresponding requested quote. shared-rule identifies the validity premise for the general pricing rules. Keep independent orders separate. A promotional discount-cap belongs only to the order carrying it. delivery-note is unrelated. Quote output slots are production cost, rush charge, discount amount, subtotal after setup, delivery charge, tax amount, and final rounded total. Future orders are unknown until asked.")
(define procedure-cell "Strict procedure, used on its own in this experiment. ANALYSIS phase: Before constructing a solution, (1) ground the problem: identify requested outputs, supplied facts, unknowns, units, applicable rules and relevant branches; (2) inspect available bindings and earlier source for relevant callable operators, checking parameters, outputs, assumptions and dependencies rather than names alone; (3) choose an approach: use a suitable existing operator with the current inputs; if none fits, explain the gap and decide whether to adapt an operator or construct one with explicit parameters. Return a concise structured analysis and operator-selection record. Do not implement yet. IMPLEMENTATION phase: implement the recorded approach, using the current inputs. Test it against the original rules with checks capable of exposing a mistake; repeating the implementation arithmetic is not an independent check. Keep new callable operators available. This procedure does not prescribe task-specific formulas or which operator to create.")
(define tier-one-limit)
(define tier-two-count)
(define tier-one-price)
(define tier-two-price)
(define tier-three-price)
(define rush-rate)
(define member-rate)
(define setup-fee)
(define delivery-fee)
(define free-delivery-threshold)
(define tax-rate)
(define pricing (struct :tier-one-limit tier-one-limit :tier-two-count tier-two-count :tier-one-price tier-one-price :tier-two-price tier-two-price :tier-three-price tier-three-price :rush-rate rush-rate :member-rate member-rate :setup-fee setup-fee :delivery-fee delivery-fee :free-delivery-threshold free-delivery-threshold :tax-rate tax-rate))
