(load-lain "model-refined.lain")
(define m (model))
(define prior-source-cell "\n\n```lisp\n(define stock-f\n  (ttms-premise-closure\n    (ttms-premise-closure\n      (network [b ip dp]\n        (* b ip (- 1 (/ dp 100))))\n      question-stock)\n    definition-stock))\n\n(define usable (stock-f boxes items-per-box damage-percent))\n\n(define order-f\n  (ttms-premise-closure\n    (ttms-premise-closure\n      (network [u oq]\n        (- u oq))\n      question-order)\n    definition-order))\n\n(define margin (order-f usable order-quantity))\n\n(define can-fill (>= margin 0))\n\n(define reply\n  (str \"Usable items: \" usable \". Margin: \" margin \". Damage status: \" damage-status \".\"))\n\n(-> reply user-output)\n```")
(define diagnostic-cell "The preceding real response was rejected by the source reader because it began with Markdown fences. No forms from that response were admitted. Return corrected raw Lain source, without backticks or prose.")
(define trigger)
(define user-output)
(define boxes)
(define items-per-box)
(define damage-percent)
(define damage-status)
(define order-quantity)
(define question-stock)
(define question-order)
(define definition-stock)
(define definition-order)
(define delivery-note)

(define role-cell "You are an agent constructing executable Lain computations inside one persistent lexical child. Read the question and input cells. Return raw parenthesized Lain forms only. Your first non-whitespace character must be (. Markdown fences such as triple backticks are invalid syntax and cause the entire response to be rejected. The input values carry TTMS premises: preserve them through the supplied supported arithmetic and premise closures. Examples are documentation, not preinstalled code.")
(define context-cell "Build a reusable inventory calculation. Define usable as the number of usable items, margin as usable minus order-quantity, and can-fill as whether margin is at least zero. Use the provided input cells rather than hardcoded input values. The stock computation must depend on question-stock and definition-stock through nested ttms-premise-closure wrappers. The order computation must depend on question-order and definition-order through nested wrappers, and reuse usable. Calling the wrapped procedures creates the result cells. Write a text reply derived from usable and margin to user-output with str. The current damage percentage is an UNVERIFIED estimate: qualify your reply using the changing damage-status cell, rather than hardcoding a certainty label. Premise activity establishes dependency, not factual certainty. Never invent a confidence percentage. Do not use delivery-note in these calculations. The host will revise or withdraw input premises after your code runs; the existing network should then update without another model request.")
(define language-cell "+ - * / >= and str are the existing support-aware TTMS operators in this environment. A closure attaches the premise of its second argument to the callable, and normal invocation carries that support into its result. Example: (define demo-f (ttms-premise-closure (network [x] (+ x 2)) demo-question)) then (define demo-answer (demo-f demo-input)). To attach both a question and a definition premise, wrap the callable twice before invoking it. (-> value target) connects cells. str joins strings and numbers. inspect:premises accepts a cell:reference and exposes its current value, supporting premises and premise states. Withdrawn inputs must yield unknown dependent values, not invented defaults. Ordinary definitions persist; support governs result availability.")
(define metadata-cell "boxes and items-per-box are supplied inventory facts. damage-percent starts at an unverified estimate of 10 percent. order-quantity is the requested count. question-stock and question-order identify the questions that triggered the respective computations. definition-stock and definition-order identify the agent's generated formulas; they are not external validation of those formulas. delivery-note is unrelated. A later inspection may supersede the estimate. Qualitative certainty must be based on source metadata, not the size of a support set.")
(define contribute (network [name reference] (network [environment] (extend-env environment (env:reference-slot name reference)))))
(define context:include (network [name] (network [names] (seq:append names name))))
(define parent-environment (|> (empty-env)
  (contribute "diagnostic-cell" (cell:reference diagnostic-cell))
  (contribute "prior-source-cell" (cell:reference prior-source-cell))
  (contribute "role-cell" (cell:reference role-cell))
  (contribute "context-cell" (cell:reference context-cell))
  (contribute "language-cell" (cell:reference language-cell))
  (contribute "metadata-cell" (cell:reference metadata-cell))
  (contribute "boxes" (cell:reference boxes))
  (contribute "items-per-box" (cell:reference items-per-box))
  (contribute "damage-status" (cell:reference damage-status))
  (contribute "damage-percent" (cell:reference damage-percent))
  (contribute "order-quantity" (cell:reference order-quantity))
  (contribute "question-stock" (cell:reference question-stock))
  (contribute "question-order" (cell:reference question-order))
  (contribute "definition-stock" (cell:reference definition-stock))
  (contribute "definition-order" (cell:reference definition-order))
  (contribute "delivery-note" (cell:reference delivery-note))
  (contribute "user-output" (cell:reference user-output))
  (contribute "cell:reference" (cell:reference cell:reference))
  (contribute "inspect:premises" (cell:reference inspect:premises))
  (contribute "+" (cell:reference ttms:+))
  (contribute "-" (cell:reference ttms:-))
  (contribute "*" (cell:reference ttms:*))
  (contribute "/" (cell:reference ttms:divide))
  (contribute ">=" (cell:reference ttms:>=))
  (contribute "str" (cell:reference ttms:str))
  (contribute "ttms-premise-closure" (cell:reference ttms:ttms-premise-closure))))
(define generated-environment (lexical-child parent-environment))
(define selected (|> (seq:empty)
  (context:include "role-cell")
  (context:include "context-cell")
  (context:include "diagnostic-cell")
  (context:include "prior-source-cell")
  (context:include "question-stock")
  (context:include "question-order")
  (context:include "boxes")
  (context:include "items-per-box")
  (context:include "damage-percent")
  (context:include "damage-status")
  (context:include "order-quantity")
  (context:include "metadata-cell")
  (context:include "language-cell")
))
(define request (cell:first (switch (data:record :id "inventory" :text (environment:describe parent-environment selected)) trigger)))
(io-model:input ((slot :worker) m) request)
(define admission-result (source:admit (model:output m) generated-environment (cell:reference (model:output m))))
