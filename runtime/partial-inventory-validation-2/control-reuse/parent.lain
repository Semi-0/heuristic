(load-lain "model-refined.lain")
(load-lain "lib/behavior-core.lain")

(define m (model))
(define ask-event)
(define ask (data:get :content ask-event))
(define active-round (data:get :round ask-event))
(define conversation-events (behavior:source))
(-> (event:point (data:get :id ask-event) (data:get :time ask-event) (data:record :role "user" :content ask)) conversation-events)
(define conversation-prefixes (behavior:scan conversation-events seq:append (seq:empty)))
(define conversation-history (behavior:latest-value conversation-prefixes (seq:empty)))
(define source-events (behavior:source))
(define source-prefixes (behavior:scan source-events seq:append (seq:empty)))
(define written-code (behavior:latest-value source-prefixes (seq:empty)))
(define model-result (model:output m))
(-> (event:point (data:get :response-sequence model-result) (data:get :response-sequence model-result) (data:get :text model-result)) source-events)
(define role-cell "You can make progress by working carefully through what is known and checking the result. You are an agent constructing executable Lain computations in a live lexical child. Read ask and the input bindings. Computed answers must come from Lain operations on input cells. Return only executable Lain source.")
(define methodology-cell "1. Understand the problem. What is the unknown? What are the data and conditions? Separate known facts, estimates, assumptions and missing information. Identify what is being asked and whether the available information suffices.\n2. Explore examples and related problems. Have you seen a related problem? Consider simpler cases, boundary cases, and alternative representations. Identify quantities, units, relationships and dependencies.\n3. Decompose and construct a solution. Break the problem into manageable parts, relate unknowns to known quantities, and connect the parts into a coherent solution. Choose an approach appropriate to the problem.\nA problem can sometimes be represented as a partial Lain network: known conditions supply inputs, unknown quantities remain open cells, and relationships connect them. You can construct relationships before all information is available, inspect what is already determined, and let later information complete the computation. Consider whether this representation is useful for the problem.\n4. Verify. Check the result against the original question, units, conditions and examples. Check each conclusion's dependencies, what happens when information changes or is withdrawn, and whether unrelated information matters. Qualify estimates and unresolved conclusions. Encouragement is not evidence of correctness. These stages do not require a prose reasoning transcript.")
(define output-format-cell "Return a sequence of complete executable Lain forms beginning with (. No Markdown fences, language labels, prose or JSON envelope. Provider thinking is separate and not admitted. New define forms create child bindings. Existing parent output ports must be connected with ->, not redefined: redefining them shadows the intended port. Each round has an existing text port user-output-1 or user-output-2. Connect a text reply there; it may explain missing information. Optional observation ports observed-total-N, observed-usable-N, observed-margin-N, observed-fulfillment-N accept total items, usable items, usable minus order quantity, and whether the order can be fulfilled, respectively. N is the round number. To expose a computed value use (-> your-value observed-total-1), for example. You may populate any useful observation ports; no port is required for source admission. Do not put numbers in the text port. Do not substitute precomputed answers for Lain computation.")
(define context-cell "One model worker and one lexical child stay alive across the questions. Earlier child bindings remain live and appear in the binding directory. written-code contains actual earlier generated source; history contains actual user messages and available text replies, maintained by reducers. Return new forms for the current ask. The parent provides inputs and output ports, not a question solution.")
(define language-cell "Lain uses (define name expression), (network [parameters] body), and prefix calls. + - * / >= and str are support-aware TTMS operators. Unknown operands leave dependent computations unknown until information is supplied. (-> value target) connects cells. str joins text and connected values. ttms-premise-closure attaches the support of its second argument to a callable; normal invocation carries that support to results. Generic example: (define demo (ttms-premise-closure (network [x] (+ x 2)) demo-premise)). Calling (demo input) computes with both input and premise support. Closures can be nested. inspect:premises accepts (cell:reference name) and exposes current value and support. Ordinary definitions persist; premise withdrawal controls availability of supported results. Premise activity does not establish truth or confidence.")
(define metadata-cell "Names ending in -1 and -2 belong to separate shipments and questions. boxes-N, items-per-box-N, damage-percent-N and order-quantity-N are independently supported input facts; percentage units are 0 through 100. damage-percent-1 is initially unknown. question-N is the premise identifying the corresponding user question and should support conclusions answering it. shared-rule is the shared premise identifying validity of agent-generated mathematical rules; it does not validate the formulas. delivery-note is unrelated metadata. Damage rates can be estimated or inspected as described by the question or supplied status. Do not invent missing facts.")
(define user-output-1)
(define observed-total-1)
(define observed-usable-1)
(define observed-margin-1)
(define observed-fulfillment-1)
(define trigger-1)
(define boxes-1)
(define items-per-box-1)
(define damage-percent-1)
(define order-quantity-1)
(define question-1)
(-> (event:point "assistant-1" 2 (data:record :role "assistant" :content user-output-1)) conversation-events)
(define user-output-2)
(define observed-total-2)
(define observed-usable-2)
(define observed-margin-2)
(define observed-fulfillment-2)
(define trigger-2)
(define boxes-2)
(define items-per-box-2)
(define damage-percent-2)
(define order-quantity-2)
(define question-2)
(-> (event:point "assistant-2" 4 (data:record :role "assistant" :content user-output-2)) conversation-events)
(define shared-rule)
(define delivery-note)
(define contribute (network [name reference] (network [environment] (extend-env environment (env:reference-slot name reference)))))
(define context:include (network [name] (network [names] (seq:append names name))))
(define parent-environment (|> (empty-env)
  (contribute "role-cell" (cell:reference role-cell))
  (contribute "methodology-cell" (cell:reference methodology-cell))
  (contribute "output-format-cell" (cell:reference output-format-cell))
  (contribute "context-cell" (cell:reference context-cell))
  (contribute "language-cell" (cell:reference language-cell))
  (contribute "metadata-cell" (cell:reference metadata-cell))
  (contribute "ask" (cell:reference ask))
  (contribute "written-code" (cell:reference written-code))
  (contribute "user-output-1" (cell:reference user-output-1))
  (contribute "observed-total-1" (cell:reference observed-total-1))
  (contribute "observed-usable-1" (cell:reference observed-usable-1))
  (contribute "observed-margin-1" (cell:reference observed-margin-1))
  (contribute "observed-fulfillment-1" (cell:reference observed-fulfillment-1))
  (contribute "boxes-1" (cell:reference boxes-1))
  (contribute "items-per-box-1" (cell:reference items-per-box-1))
  (contribute "damage-percent-1" (cell:reference damage-percent-1))
  (contribute "order-quantity-1" (cell:reference order-quantity-1))
  (contribute "question-1" (cell:reference question-1))
  (contribute "user-output-2" (cell:reference user-output-2))
  (contribute "observed-total-2" (cell:reference observed-total-2))
  (contribute "observed-usable-2" (cell:reference observed-usable-2))
  (contribute "observed-margin-2" (cell:reference observed-margin-2))
  (contribute "observed-fulfillment-2" (cell:reference observed-fulfillment-2))
  (contribute "boxes-2" (cell:reference boxes-2))
  (contribute "items-per-box-2" (cell:reference items-per-box-2))
  (contribute "damage-percent-2" (cell:reference damage-percent-2))
  (contribute "order-quantity-2" (cell:reference order-quantity-2))
  (contribute "question-2" (cell:reference question-2))
  (contribute "shared-rule" (cell:reference shared-rule))
  (contribute "delivery-note" (cell:reference delivery-note))
  (contribute "history" (cell:reference conversation-history))
  (contribute "+" (cell:reference ttms:+))
  (contribute "-" (cell:reference ttms:-))
  (contribute "*" (cell:reference ttms:*))
  (contribute "/" (cell:reference ttms:divide))
  (contribute ">=" (cell:reference ttms:>=))
  (contribute "str" (cell:reference ttms:str))
  (contribute "ttms-premise-closure" (cell:reference ttms:ttms-premise-closure))
  (contribute "inspect:premises" (cell:reference inspect:premises))
  (contribute "cell:reference" (cell:reference cell:reference))
))
(define generated-environment (lexical-child parent-environment))
(define selected (|> (seq:empty)
  (context:include "role-cell")
  (context:include "methodology-cell")
  (context:include "output-format-cell")
  (context:include "context-cell")
  (context:include "language-cell")
  (context:include "metadata-cell")
  (context:include "ask")
  (context:include "written-code")
  (context:include "user-output-1")
  (context:include "observed-total-1")
  (context:include "observed-usable-1")
  (context:include "observed-margin-1")
  (context:include "observed-fulfillment-1")
  (context:include "boxes-1")
  (context:include "items-per-box-1")
  (context:include "damage-percent-1")
  (context:include "order-quantity-1")
  (context:include "question-1")
  (context:include "user-output-2")
  (context:include "observed-total-2")
  (context:include "observed-usable-2")
  (context:include "observed-margin-2")
  (context:include "observed-fulfillment-2")
  (context:include "boxes-2")
  (context:include "items-per-box-2")
  (context:include "damage-percent-2")
  (context:include "order-quantity-2")
  (context:include "question-2")
  (context:include "shared-rule")
  (context:include "delivery-note")
  (context:include "history")
))
(define request-1 (cell:first (switch (data:record :id "round-1" :text (environment:describe generated-environment selected)) trigger-1)))
(io-model:input ((slot :worker) m) request-1)
(define request-2 (cell:first (switch (data:record :id "round-2" :text (environment:describe generated-environment selected)) trigger-2)))
(io-model:input ((slot :worker) m) request-2)
(define admission-result (source:admit (model:output m) generated-environment (cell:reference (model:output m))))
