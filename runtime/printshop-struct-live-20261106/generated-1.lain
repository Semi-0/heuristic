

(define q1 ((slot :quantity) order-1))
(define rush1 ((slot :rush?) order-1))
(define member1 ((slot :member?) order-1))
(define cap1 ((slot :discount-cap) order-1))
(define tier1-copies (min q1 tier-one-limit))
(define tier2-copies (min (max (- q1 tier-one-limit) 0) tier-two-count))
(define tier3-copies (max (- q1 tier-one-limit tier-two-count) 0))
(define production (+ (* tier1-copies tier-one-price) (* tier2-copies tier-two-price) (* tier3-copies tier-three-price)))
(define rush-charge (select rush1 (* rush-rate production) 0))
(define discount (select member1 (min (* member-rate (+ production rush-charge)) cap1) 0))
(define subtotal (+ (- production rush-charge discount) setup-fee))
(define delivery (select (>= subtotal free-delivery-threshold) 0 delivery-fee))
(define tax (* tax-rate (+ subtotal delivery)))
(define total (round-money (+ subtotal delivery tax)))
(-> production ((slot :production) quote-1))
(-> rush-charge ((slot :rush) quote-1))
(-> discount ((slot :discount) quote-1))
(-> subtotal ((slot :subtotal) quote-1))
(-> delivery ((slot :delivery) quote-1))
(-> tax ((slot :tax) quote-1))
(-> total ((slot :total) quote-1))
(-> (str "Production: $" production "\nRush: $" rush-charge "\nDiscount: $" discount "\nSubtotal: $" subtotal "\nDelivery: $" delivery "\nTax: $" tax "\nTotal: $" total) user-output-1)
(-> (= total (round-money (+ subtotal delivery tax))) self-check-1)