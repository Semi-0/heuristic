

(define q4 ((slot :quantity) order-4))
(define rush4 ((slot :rush?) order-4))
(define member4 ((slot :member?) order-4))
(define cap4 ((slot :discount-cap) order-4))
(define tier1-copies-4 (min q4 tier-one-limit))
(define tier2-copies-4 (min (max (- q4 tier-one-limit) 0) tier-two-count))
(define tier3-copies-4 (max (- q4 tier-one-limit tier-two-count) 0))
(define production-4 (+ (* tier1-copies-4 tier-one-price) (* tier2-copies-4 tier-two-price) (* tier3-copies-4 tier-three-price)))
(define rush-charge-4 (select rush4 (* rush-rate production-4) 0))
(define discount-4 (select member4 (min (* member-rate (+ production-4 rush-charge-4)) cap4) 0))
(define subtotal-4 (+ (- production-4 rush-charge-4 discount-4) setup-fee))
(define delivery-4 (select (>= subtotal-4 free-delivery-threshold) 0 delivery-fee))
(define tax-4 (* tax-rate (+ subtotal-4 delivery-4)))
(define total-4 (round-money (+ subtotal-4 delivery-4 tax-4)))
(-> production-4 ((slot :production) quote-4))
(-> rush-charge-4 ((slot :rush) quote-4))
(-> discount-4 ((slot :discount) quote-4))
(-> subtotal-4 ((slot :subtotal) quote-4))
(-> delivery-4 ((slot :delivery) quote-4))
(-> tax-4 ((slot :tax) quote-4))
(-> total-4 ((slot :total) quote-4))
(-> (str "Production: $" production-4 "\nRush: $" rush-charge-4 "\nDiscount: $" discount-4 "\nSubtotal: $" subtotal-4 "\nDelivery: $" delivery-4 "\nTax: $" tax-4 "\nTotal: $" total-4) user-output-4)
(-> (= total-4 (round-money (+ subtotal-4 delivery-4 tax-4))) self-check-4)