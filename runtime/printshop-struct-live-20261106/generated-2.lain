

(define q2 ((slot :quantity) order-2))
(define rush2 ((slot :rush?) order-2))
(define member2 ((slot :member?) order-2))
(define cap2 ((slot :discount-cap) order-2))
(define tier1-copies-2 (min q2 tier-one-limit))
(define tier2-copies-2 (min (max (- q2 tier-one-limit) 0) tier-two-count))
(define tier3-copies-2 (max (- q2 tier-one-limit tier-two-count) 0))
(define production-2 (+ (* tier1-copies-2 tier-one-price) (* tier2-copies-2 tier-two-price) (* tier3-copies-2 tier-three-price)))
(define rush-charge-2 (select rush2 (* rush-rate production-2) 0))
(define discount-2 (select member2 (min (* member-rate (+ production-2 rush-charge-2)) cap2) 0))
(define subtotal-2 (+ (- production-2 rush-charge-2 discount-2) setup-fee))
(define delivery-2 (select (>= subtotal-2 free-delivery-threshold) 0 delivery-fee))
(define tax-2 (* tax-rate (+ subtotal-2 delivery-2)))
(define total-2 (round-money (+ subtotal-2 delivery-2 tax-2)))
(-> production-2 ((slot :production) quote-2))
(-> rush-charge-2 ((slot :rush) quote-2))
(-> discount-2 ((slot :discount) quote-2))
(-> subtotal-2 ((slot :subtotal) quote-2))
(-> delivery-2 ((slot :delivery) quote-2))
(-> tax-2 ((slot :tax) quote-2))
(-> total-2 ((slot :total) quote-2))
(-> (str "Production: $" production-2 "\nRush: $" rush-charge-2 "\nDiscount: $" discount-2 "\nSubtotal: $" subtotal-2 "\nDelivery: $" delivery-2 "\nTax: $" tax-2 "\nTotal: $" total-2) user-output-2)
(-> (= total-2 (round-money (+ subtotal-2 delivery-2 tax-2))) self-check-2)