

(define q3 ((slot :quantity) order-3))
(define rush3 ((slot :rush?) order-3))
(define member3 ((slot :member?) order-3))
(define cap3 ((slot :discount-cap) order-3))
(define tier1-copies-3 (min q3 tier-one-limit))
(define tier2-copies-3 (min (max (- q3 tier-one-limit) 0) tier-two-count))
(define tier3-copies-3 (max (- q3 tier-one-limit tier-two-count) 0))
(define production-3 (+ (* tier1-copies-3 tier-one-price) (* tier2-copies-3 tier-two-price) (* tier3-copies-3 tier-three-price)))
(define rush-charge-3 (select rush3 (* rush-rate production-3) 0))
(define discount-3 (select member3 (min (* member-rate (+ production-3 rush-charge-3)) cap3) 0))
(define subtotal-3 (+ (- production-3 rush-charge-3 discount-3) setup-fee))
(define delivery-3 (select (>= subtotal-3 free-delivery-threshold) 0 delivery-fee))
(define tax-3 (* tax-rate (+ subtotal-3 delivery-3)))
(define total-3 (round-money (+ subtotal-3 delivery-3 tax-3)))
(-> production-3 ((slot :production) quote-3))
(-> rush-charge-3 ((slot :rush) quote-3))
(-> discount-3 ((slot :discount) quote-3))
(-> subtotal-3 ((slot :subtotal) quote-3))
(-> delivery-3 ((slot :delivery) quote-3))
(-> tax-3 ((slot :tax) quote-3))
(-> total-3 ((slot :total) quote-3))
(-> (str "Production: $" production-3 "\nRush: $" rush-charge-3 "\nDiscount: $" discount-3 "\nSubtotal: $" subtotal-3 "\nDelivery: $" delivery-3 "\nTax: $" tax-3 "\nTotal: $" total-3) user-output-3)
(-> (= total-3 (round-money (+ subtotal-3 delivery-3 tax-3))) self-check-3)