

(define q5 ((slot :quantity) order-5))
(define rush5 ((slot :rush?) order-5))
(define member5 ((slot :member?) order-5))
(define cap5 ((slot :discount-cap) order-5))
(define tier1-copies-5 (min q5 tier-one-limit))
(define tier2-copies-5 (min (max (- q5 tier-one-limit) 0) tier-two-count))
(define tier3-copies-5 (max (- q5 tier-one-limit tier-two-count) 0))
(define production-5 (+ (* tier1-copies-5 tier-one-price) (* tier2-copies-5 tier-two-price) (* tier3-copies-5 tier-three-price)))
(define rush-charge-5 (select rush5 (* rush-rate production-5) 0))
(define discount-5 (select member5 (min (* member-rate (+ production-5 rush-charge-5)) cap5) 0))
(define subtotal-5 (+ (- production-5 rush-charge-5 discount-5) setup-fee))
(define delivery-5 (select (>= subtotal-5 free-delivery-threshold) 0 delivery-fee))
(define tax-5 (* tax-rate (+ subtotal-5 delivery-5)))
(define total-5 (round-money (+ subtotal-5 delivery-5 tax-5)))
(-> production-5 ((slot :production) quote-5))
(-> rush-charge-5 ((slot :rush) quote-5))
(-> discount-5 ((slot :discount) quote-5))
(-> subtotal-5 ((slot :subtotal) quote-5))
(-> delivery-5 ((slot :delivery) quote-5))
(-> tax-5 ((slot :tax) quote-5))
(-> total-5 ((slot :total) quote-5))
(-> (str "Production: $" production-5 "\nRush: $" rush-charge-5 "\nDiscount: $" discount-5 "\nSubtotal: $" subtotal-5 "\nDelivery: $" delivery-5 "\nTax: $" tax-5 "\nTotal: $" total-5) user-output-5)
(-> (= total-5 (round-money (+ subtotal-5 delivery-5 tax-5))) self-check-5)