(define print-quote
  (ttms-premise-closure
    (network [order pricing]
      (define quantity ((slot :quantity) order))
      (define rush? ((slot :rush?) order))
      (define member? ((slot :member?) order))
      (define discount-cap ((slot :discount-cap) order))
      (define tier-one-limit ((slot :tier-one-limit) pricing))
      (define tier-one-price ((slot :tier-one-price) pricing))
      (define tier-two-count ((slot :tier-two-count) pricing))
      (define tier-two-price ((slot :tier-two-price) pricing))
      (define tier-three-price ((slot :tier-three-price) pricing))
      (define rush-rate ((slot :rush-rate) pricing))
      (define member-rate ((slot :member-rate) pricing))
      (define setup-fee ((slot :setup-fee) pricing))
      (define delivery-fee ((slot :delivery-fee) pricing))
      (define free-delivery-threshold ((slot :free-delivery-threshold) pricing))
      (define tax-rate ((slot :tax-rate) pricing))
      (define tier1-copies (min quantity tier-one-limit))
      (define tier2-copies (min (max (- quantity tier-one-limit) 0) tier-two-count))
      (define tier3-copies (max (- quantity tier-one-limit tier-two-count) 0))
      (define production (+ (* tier1-copies tier-one-price) (* tier2-copies tier-two-price) (* tier3-copies tier-three-price)))
      (define rush-charge (select rush? (* rush-rate production) 0))
      (define raw-discount (select member? (* member-rate (+ production rush-charge)) 0))
      (define discount (min raw-discount discount-cap))
      (define subtotal (- (+ production rush-charge setup-fee) discount))
      (define delivery (select (>= subtotal free-delivery-threshold) 0 delivery-fee))
      (define tax (* tax-rate (+ subtotal delivery)))
      (define total (round-money (+ subtotal delivery tax)))
      (struct :production production :rush rush-charge :discount discount :subtotal subtotal :delivery delivery :tax tax :total total))
    shared-rule))

(define quote-result (print-quote order-1 pricing))

(-> ((slot :production) quote-result) ((slot :production) quote-1))
(-> ((slot :rush) quote-result) ((slot :rush) quote-1))
(-> ((slot :discount) quote-result) ((slot :discount) quote-1))
(-> ((slot :subtotal) quote-result) ((slot :subtotal) quote-1))
(-> ((slot :delivery) quote-result) ((slot :delivery) quote-1))
(-> ((slot :tax) quote-result) ((slot :tax) quote-1))
(-> ((slot :total) quote-result) ((slot :total) quote-1))

(-> (str "Quote for " ((slot :quantity) order-1) " copies (standard, nonmember):\n"
        "Production: $" ((slot :production) quote-result) "\n"
        "Rush surcharge: $" ((slot :rush) quote-result) "\n"
        "Member discount: $" ((slot :discount) quote-result) "\n"
        "Subtotal (incl. setup): $" ((slot :subtotal) quote-result) "\n"
        "Delivery: $" ((slot :delivery) quote-result) "\n"
        "Tax: $" ((slot :tax) quote-result) "\n"
        "Total: $" ((slot :total) quote-result))
    user-output-1)

(-> (= ((slot :total) quote-result)
       (round-money (+ ((slot :subtotal) quote-result)
                       ((slot :delivery) quote-result)
                       ((slot :tax) quote-result))))
    self-check-1)