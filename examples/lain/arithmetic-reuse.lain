(load-lain "model-refined.lain")
(load-lain "lib/behavior-core.lain")

(define m (model))
(define ask-event)
(define ask (data:get :content ask-event))
(define active-round (data:get :round ask-event))
(define conversation-events (behavior:source))
(-> (event:point (data:get :id ask-event) (data:get :time ask-event) (data:record :role "user" :content ask)) conversation-events)
(define conversation-prefixes (behavior:scan conversation-events seq:append (seq:empty)))
(define conversation-history (behavior:latest-value conversation-prefixes (seq:empty)))
(define source-events (behavior:source))
(define source-prefixes (behavior:scan source-events seq:append (seq:empty)))
(define written-code (behavior:latest-value source-prefixes (seq:empty)))
(define model-result (model:output m))
(-> (event:point (data:get :response-sequence model-result) (data:get :response-sequence model-result) (data:get :text model-result)) source-events)
(define user-output-1)
(define observed-value-1)
(define observed-1 (struct :result observed-value-1))
(define trigger-1)
(-> (event:point "assistant-1" 2 (data:record :role "assistant" :content user-output-1)) conversation-events)
(define user-output-2)
(define observed-value-2)
(define observed-2 (struct :result observed-value-2))
(define trigger-2)
(-> (event:point "assistant-2" 4 (data:record :role "assistant" :content user-output-2)) conversation-events)
(define user-output-3)
(define observed-value-3)
(define observed-3 (struct :result observed-value-3))
(define trigger-3)
(-> (event:point "assistant-3" 6 (data:record :role "assistant" :content user-output-3)) conversation-events)
(define role-cell
  "You are the agent inside a live Lain environment. Read the user's question from ask. Write executable Lain source that constructs the computation and connects its answer to the provided output cells. Source is admitted into a lexical child inheriting these bindings. Return only Lain source, without Markdown fences.")
(define context-cell
  (text:format "This is round %s in ONE persistent lexical child. Answer ask by building actual Lain arithmetic. Define result-%s for this round and attach it to observed-%s's :result slot. Write a text reply derived from that value to user-output-%s. Previous result cells and their definitions persist; written-code contains your actual earlier source and history contains real messages. When asked to use a previous result, reference its existing cell by name in the new arithmetic expression. Do not substitute its numeric value, repeat its earlier calculation, or redefine earlier cells. Result cells are named result-1, result-2, result-3 in round order. The parent maintains conversation history. Return only new executable forms for the current round. Definitions alone do not write the observation or reply: connect both output ports."
               active-round active-round active-round active-round))
(define language-cell
  "Lain uses prefix arithmetic and connected expressions. (define name expression) binds a cell. + adds, - subtracts, * multiplies, / divides. A nested call composes computations. (-> value target) connects cells. (struct :key cell) exposes a cell as a named slot. ((slot :key) object) accesses that slot, including as a connection target. text:format constructs text from a template and connected values. Unknown cells wait for information. The following examples are documentation only.")
(define examples-cell
  "Arithmetic: (define demo-number (- 9 (* 2 3))) produces 3.
Observation: given (define demo-result) and (define demo-observed (struct :result demo-result)), (-> demo-number ((slot :result) demo-observed)) attaches that number to the result slot.
Reply: given (define demo-output), (-> (text:format \"The answer is %s.\" demo-number) demo-output) writes text derived from the computed number.
Reading history: history is a vector of role/content records maintained by the parent reducer. It contains real user inputs and output-cell replies, not model source or thinking.")
(define context:include (network [name] (network [names] (seq:append names name))))
(define contribute (network [name reference] (network [environment] (extend-env environment (env:reference-slot name reference)))))
(define parent-environment
  (|> (empty-env)
      (contribute "role-cell" (cell:reference role-cell))
      (contribute "context-cell" (cell:reference context-cell))
      (contribute "language-cell" (cell:reference language-cell))
      (contribute "examples-cell" (cell:reference examples-cell))
      (contribute "ask" (cell:reference ask))
      (contribute "observed-1" (cell:reference observed-1))
      (contribute "user-output-1" (cell:reference user-output-1))
      (contribute "observed-2" (cell:reference observed-2))
      (contribute "user-output-2" (cell:reference user-output-2))
      (contribute "observed-3" (cell:reference observed-3))
      (contribute "user-output-3" (cell:reference user-output-3))
      (contribute "written-code" (cell:reference written-code))
      (contribute "history" (cell:reference conversation-history))
      (contribute "+" (cell:reference +))
      (contribute "-" (cell:reference -))
      (contribute "*" (cell:reference *))
      (contribute "/" (cell:reference /))
      (contribute "slot" (cell:reference slot))
      (contribute "text:format" (cell:reference text:format))))
(define generated-environment (lexical-child parent-environment))
(define selection (|> (seq:empty)
                      (context:include "role-cell")
                      (context:include "context-cell")
                      (context:include "ask")
                      (context:include "history")
                      (context:include "language-cell")
                      (context:include "examples-cell")
                      (context:include "written-code")
                      (context:include "result-1")
                      (context:include "result-2")
                      (context:include "result-3")
                      (context:include "observed-1")
                      (context:include "user-output-1")
                      (context:include "observed-2")
                      (context:include "user-output-2")
                      (context:include "observed-3")
                      (context:include "user-output-3")))
(define request-1 (cell:first (switch (data:record :id "round-1" :text (environment:describe generated-environment selection)) trigger-1)))
(io-model:input ((slot :worker) m) request-1)
(define request-2 (cell:first (switch (data:record :id "round-2" :text (environment:describe generated-environment selection)) trigger-2)))
(io-model:input ((slot :worker) m) request-2)
(define request-3 (cell:first (switch (data:record :id "round-3" :text (environment:describe generated-environment selection)) trigger-3)))
(io-model:input ((slot :worker) m) request-3)
(define admission-result (source:admit (model:output m) generated-environment (cell:reference (model:output m))))
