(define quote-1 (struct :production observed-production-1 :rush observed-rush-1 :discount observed-discount-1 :subtotal observed-subtotal-1 :delivery observed-delivery-1 :tax observed-tax-1 :total observed-total-1))
(-> (event:point "assistant-1" 2 (data:record :role "assistant" :content (cell:first user-output-1))) conversation-events)
