(load-lain "experiments/catalog-common.lain")
(load-lain "environments/catalog-directed.lain")
(define discover-runtime (runtime (struct :bindings directed-seed :request request-input)
 (struct :input (model:input m) :output (switch raw-response (data:equal? (data:get :request-id raw-response) "discover")))))
(define discover-receipt ((slot :compilation) discover-runtime))
(define discover-status (data:get :status (cell:first discover-receipt)))
(define choose-runtime (runtime (struct :bindings directed-seed :request request-input)
 (struct :input (model:input m) :output (switch raw-response (data:equal? (data:get :request-id raw-response) "choose")))))
(define choose-receipt ((slot :compilation) choose-runtime))
(define choose-status (data:get :status (cell:first choose-receipt)))
(define execute-runtime (runtime (struct :bindings directed-seed :request request-input)
 (struct :input (model:input m) :output (switch raw-response (data:equal? (data:get :request-id raw-response) "execute")))))
(define execute-receipt ((slot :compilation) execute-runtime))
(define execute-status (data:get :status (cell:first execute-receipt)))
(define selected-bundle
 (catalog:selected-source (switch selected-id (data:equal? choose-status :admitted))))
(define selected-modules (data:get :modules selected-bundle))
(define restore-packet (network [id source]
 (data:record :request-id id :kind :reply :finish-reason "stop" :truncated? false :text source)))
;; Bounded three-module experiment; an unselected module has empty source.
(define restored-env-0 (lexical-child seed))
(define restore-receipt-0 (incremental-compile (restore-packet "restore/0" (data:get :source (data:get 0 selected-modules))) restored-env-0))
(define restore-status-0 (data:get :status (cell:first restore-receipt-0)))
(define restored-env-1 (lexical-child seed))
(define restore-receipt-1 (incremental-compile (switch (restore-packet "restore/1" (data:get :source (data:get 1 selected-modules))) (data:equal? restore-status-0 :admitted)) restored-env-1))
(define restore-status-1 (data:get :status (cell:first restore-receipt-1)))
(define restored-env-2 (lexical-child seed))
(define restore-receipt-2 (incremental-compile (switch (restore-packet "restore/2" (data:get :source (data:get 2 selected-modules))) (data:equal? restore-status-1 :admitted)) restored-env-2))
(define restore-status-2 (data:get :status (cell:first restore-receipt-2)))
(define restoration-ready (data:equal? restore-status-2 :admitted))
(stage-in directed-seed "discover" 1 directed-search-task start "Fresh process: catalog metadata only; no executable references are live.")
(stage-in directed-seed "choose" 2 (if accumulate-mode directed-select-new directed-select-reuse)
 (data:equal? discover-status :admitted) discovery-results)
(stage-in directed-seed "execute" 3 (if accumulate-mode directed-compose-task directed-reuse-task)
 restoration-ready (seq:of selected-id selection-notes))
