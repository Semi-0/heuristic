(load-lain "propagators/compiler_2/runtime/lain/combinator.lain")
;; Namespaced beside soul.lain in the SAME session; fields remain connected.
(def-cells h4:request h4:observation h4:capabilities h4:weather-mode h4:unrelated)
(def-cells h4:answer h4:answer-2 h4:answer-live h4:model-input)
(define h4:describe-environment
  (network [e]
    (h4:description (|> e (slot :request)) (|> e (slot :guide))
                   (|> e (slot :design)) (|> e (slot :capabilities))
                   (|> e (slot :observation)))))
(define h4:inputs-of (slot :inputs))
(define h4:actions-of (slot :actions))
(define h4:model-view (struct :inputs h4:model-input :actions (h4:model h4:model-input)))
(define h4:environment
  (struct :request h4:request :guide h4:guide :design h4:design
          :capabilities h4:capabilities :observation h4:observation
          :unrelated h4:unrelated))
(define h4:weather-rain-probability
  (network [place date] (h4:weather place date h4:weather-mode)))
(define h4:runtime
  (network [e model]
    (-> (h4:describe-environment e) (h4:inputs-of model))
    (h4:install (h4:source (h4:actions-of model)))))
(define h4:execution (h4:runtime h4:environment h4:model-view))
;; h4:unrelated is deliberately unknown and does not block the model.
