(load-lain "soul-refined.lain")
(load-lain "lib/behavior-core.lain")
(define spec)
(define agent (model))
(define requests (behavior:source))
(-> (behavior:latest-value requests) (model:input agent))
(define raw (model:output agent))
(define message (network [role text] (data:record :role role :content text)))
(define started (seq:of (message "system" (data:get :role spec)) (message "user" (data:get :task spec))))
(define bind (network [e name ref] (extend-env e (env:reference-slot name ref))))
(define bindings (bind (bind (bind (bind (empty-env) "+" (cell:reference +)) "*" (cell:reference *))
                             "-" (cell:reference -)) "<=" (cell:reference <=)))
(define workspace (lexical-child bindings))

;; The invoice operator publishes the named observation only when requested.
(define invoice120)
(define policy)
(define target-count)
(define marginal (ttms:ttms-premise-closure (network [n] (if (ttms:<= n 100)
  (ttms:* n 200) (ttms:+ 20000 (ttms:* 150 (ttms:- n 100))))) policy))
(define whole (ttms:ttms-premise-closure (network [n] (if (ttms:<= n 100) (ttms:* n 200) (ttms:* n 150))) policy))
(define flat (ttms:ttms-premise-closure (network [n] (ttms:* n 175)) policy))
(define quote-at-target (network [f] (switch (f target-count) (ttms:= (f 120) invoice120))))
(define marginal-result (quote-at-target marginal))
(define whole-result (quote-at-target whole))
(define flat-result (quote-at-target flat))

(define turn (network [id time messages]
  (let [packet (data:record :id id :messages messages :text (data:get :role spec))
        sent (event:point id time packet)
        reply (cell:first (switch raw (data:equal? (data:get :request-id raw) id)))
        receipt (cell:first (attempt:perform id reply workspace))
        history (seq:concat messages (seq:of (message "assistant" (data:get :text reply))
          (message "user" (data:get :feedback receipt))))]
    (-> sent requests)
    (struct :next (switch history (data:equal? (data:get :done receipt) false))
            :receipt receipt))))
(define t1 (turn "one" 1 started))
(define t2 (turn "two" 2 ((slot :next) t1)))
(define t3 (turn "three" 3 ((slot :next) t2)))
(define t4 (turn "four" 4 ((slot :next) t3)))
