(load-lain "experiments/catalog-common.lain")
(load-lain "environments/catalog-cumulative.lain")
(define compose-runtime (runtime (struct :bindings cumulative-seed :request request-input)
 (struct :input (model:input m) :output (switch raw-response (data:equal? (data:get :request-id raw-response) "compose")))))
(define compose-admission ((slot :compilation) compose-runtime))
(define search-next-runtime (runtime (struct :bindings cumulative-seed :request request-input)
 (struct :input (model:input m) :output (switch raw-response (data:equal? (data:get :request-id raw-response) "search-next")))))
(define search-next-admission ((slot :compilation) search-next-runtime))
(define apply-next-runtime (runtime (struct :bindings cumulative-seed :request request-input)
 (struct :input (model:input m) :output (switch raw-response (data:equal? (data:get :request-id raw-response) "apply-next")))))
(define apply-next-admission ((slot :compilation) apply-next-runtime))
(stage "build" 1 build-task start "Seed the documented library through ordinary completed-source admission.")
(stage-in cumulative-seed "search" 2 search-examples-task (data:equal? (data:get :status library-admission) :admitted) library-ready)
(stage-in cumulative-seed "compose" 3 compose-task (data:equal? (data:get :status search-admission) :admitted) discovery-results)
(stage-in cumulative-seed "search-next" 4 search-next-task (data:equal? (data:get :status compose-admission) :admitted) cumulative-ready)
(stage-in cumulative-seed "apply-next" 5 apply-next-task (data:equal? (data:get :status search-next-admission) :admitted) next-discovery-results)
