;; Lain owns phase progression and bounded recovery. Question publication is external input.
(define question-event-1 (cell:first (switch ask-event (data:equal? active-round 1))))
(define round-outcome-1)
(when (data:has? question-event-1 :content)
  (experiment:question (cell:reference generated-environment) selected experiment-worker (cell:reference raw-model-result) (cell:reference admission-result) (cell:reference request-events) (cell:reference repair-detail-events)
    1 true
    (data:record :premises (data:record :question (cell:reference question-1) :rule (cell:reference shared-rule)) :production (cell:reference observed-production-1) :rush (cell:reference observed-rush-1) :discount (cell:reference observed-discount-1) :subtotal (cell:reference observed-subtotal-1) :delivery (cell:reference observed-delivery-1) :tax (cell:reference observed-tax-1) :total (cell:reference observed-total-1) :reply (cell:reference user-output-1))
    (data:get :content question-event-1) (cell:reference round-outcome-1)))
