(load-lain "experiments/catalog-common.lain")
(load-lain "environments/catalog-semantic.lain")
(load-lain "lib/output-repair.lain")
(load-lain "lib/semantic-repair.lain")
(define discover-outcome (let-cell [port] port))
(define choose-outcome (let-cell [port] port))
(define discover-runtime (runtime (struct :bindings semantic-seed :request request-input)
 (struct :input (model:input m) :output (switch raw-response (data:equal? (data:get :request-id raw-response) "discover")))))
(define discover-receipt ((slot :compilation) discover-runtime))
(define discover-status (data:get :status (cell:first discover-receipt)))
(define choose-runtime (runtime (struct :bindings semantic-seed :request request-input)
 (struct :input (model:input m) :output (switch raw-response (data:equal? (data:get :request-id raw-response) "choose")))))
(define choose-receipt ((slot :compilation) choose-runtime))
(define choose-status (data:get :status (cell:first choose-receipt)))
(define candidate-0-base (let-cell [port] port))
(define candidate-0-historical (let-cell [port] port))
(define candidate-0-answer (let-cell [port] port))
(define candidate-0-reply (let-cell [port] port))
(define semantic-attempt-0 (let-cell [port] port))
(define candidate-1-base (let-cell [port] port))
(define candidate-1-historical (let-cell [port] port))
(define candidate-1-answer (let-cell [port] port))
(define candidate-1-reply (let-cell [port] port))
(define semantic-attempt-1 (let-cell [port] port))
(define candidate-2-base (let-cell [port] port))
(define candidate-2-historical (let-cell [port] port))
(define candidate-2-answer (let-cell [port] port))
(define candidate-2-reply (let-cell [port] port))
(define semantic-attempt-2 (let-cell [port] port))
(define candidate-seed-0 (semantic:ports semantic-seed (cell:reference candidate-0-base) (cell:reference candidate-0-historical) (cell:reference candidate-0-answer) (cell:reference candidate-0-reply)))
(define execute-runtime (runtime (struct :bindings candidate-seed-0 :request request-input)
 (struct :input (model:input m) :output (switch raw-response (data:equal? (data:get :request-id raw-response) "execute")))))
(define execute-receipt ((slot :compilation) execute-runtime))
(define execute-status (data:get :status (cell:first execute-receipt)))
(define selected-bundle
 (catalog:selected-source (switch selected-id (data:equal? (data:get :status choose-outcome) :done))))
(define selected-modules (data:get :modules selected-bundle))
(define restore-packet (network [id source]
 (data:record :request-id id :kind :reply :finish-reason "stop" :truncated? false :text source)))
;; Bounded three-module experiment; an unselected module has empty source.
(define restored-env-0 (lexical-child seed))
(define restore-receipt-0 (incremental-compile (restore-packet "restore/0" (data:get :source (data:get 0 selected-modules))) restored-env-0))
(define restore-status-0 (data:get :status (cell:first restore-receipt-0)))
(define restored-env-1 (lexical-child seed))
(define restore-receipt-1 (incremental-compile (switch (restore-packet "restore/1" (data:get :source (data:get 1 selected-modules))) (data:equal? restore-status-0 :admitted)) restored-env-1))
(define restore-status-1 (data:get :status (cell:first restore-receipt-1)))
(define restored-env-2 (lexical-child seed))
(define restore-receipt-2 (incremental-compile (switch (restore-packet "restore/2" (data:get :source (data:get 2 selected-modules))) (data:equal? restore-status-1 :admitted)) restored-env-2))
(define restore-status-2 (data:get :status (cell:first restore-receipt-2)))
(define restoration-ready (data:equal? restore-status-2 :admitted))
(stage-in semantic-seed "discover" 10 directed-search-task start "Fresh process: catalog metadata only; no executable references are live.")
(stage-in semantic-seed "choose" 20 policy-choose-task
 (data:equal? (data:get :status discover-outcome) :done) discovery-results)
(stage-in semantic-seed "execute" 30 policy-execute-task
 restoration-ready (seq:of selected-id selection-notes))

(repair:phase ((slot :environment) discover-runtime)
 (data:record :first (cell:reference discovery-results) :second (cell:reference discovery-results))
 ((slot :worker) m) (cell:reference raw-response) discover-receipt (cell:reference request-events)
 "discover" 10 repair-discover-task (cell:reference discover-outcome))

(repair:phase ((slot :environment) choose-runtime)
 (data:record :first (cell:reference selected-id) :second (cell:reference selection-notes))
 ((slot :worker) m) (cell:reference raw-response) choose-receipt (cell:reference request-events)
 "choose" 20 repair-choose-task (cell:reference choose-outcome))

(define candidate-env-0 ((slot :environment) execute-runtime))
(define semantic-domain (logic:all (>= delivery-charge 0) (>= surcharge-rate 0)))
(define semantic-reply-0 (cell:first (switch raw-response (data:equal? (data:get :request-id raw-response) "execute"))))
(semantic:attempt candidate-env-0
 (data:record :first (cell:reference candidate-0-answer) :second (cell:reference candidate-0-historical)
              :base (cell:reference candidate-0-base) :reply (cell:reference candidate-0-reply))
 ((slot :worker) m) semantic-reply-0 execute-receipt semantic-domain (cell:reference semantic-attempt-0))
(define semantic-ok-0 (data:get :valid? semantic-attempt-0))
(define candidate-env-1 (lexical-child (semantic:ports candidate-env-0
 (cell:reference candidate-1-base) (cell:reference candidate-1-historical)
 (cell:reference candidate-1-answer) (cell:reference candidate-1-reply))))
(repair:request candidate-env-1 "execute-repair-1" 31 semantic-repair-task
 (semantic:feedback semantic-attempt-0 2) (logic:not semantic-ok-0) (cell:reference request-events))
(define semantic-reply-1 (cell:first (switch raw-response (data:equal? (data:get :request-id raw-response) "execute-repair-1"))))
(define semantic-receipt-1 (incremental-compile semantic-reply-1 candidate-env-1))
(semantic:attempt candidate-env-1
 (data:record :first (cell:reference candidate-1-answer) :second (cell:reference candidate-1-historical)
              :base (cell:reference candidate-1-base) :reply (cell:reference candidate-1-reply))
 ((slot :worker) m) semantic-reply-1 semantic-receipt-1 semantic-domain (cell:reference semantic-attempt-1))
(define semantic-ok-1 (data:get :valid? semantic-attempt-1))
(define candidate-env-2 (lexical-child (semantic:ports candidate-env-1
 (cell:reference candidate-2-base) (cell:reference candidate-2-historical)
 (cell:reference candidate-2-answer) (cell:reference candidate-2-reply))))
(repair:request candidate-env-2 "execute-repair-2" 32 semantic-repair-task
 (semantic:feedback semantic-attempt-1 1) (logic:not semantic-ok-1) (cell:reference request-events))
(define semantic-reply-2 (cell:first (switch raw-response (data:equal? (data:get :request-id raw-response) "execute-repair-2"))))
(define semantic-receipt-2 (incremental-compile semantic-reply-2 candidate-env-2))
(semantic:attempt candidate-env-2
 (data:record :first (cell:reference candidate-2-answer) :second (cell:reference candidate-2-historical)
              :base (cell:reference candidate-2-base) :reply (cell:reference candidate-2-reply))
 ((slot :worker) m) semantic-reply-2 semantic-receipt-2 semantic-domain (cell:reference semantic-attempt-2))
(define semantic-ok-2 (data:get :valid? semantic-attempt-2))
(-> (if semantic-ok-0 candidate-0-base (if semantic-ok-1 candidate-1-base (switch candidate-2-base semantic-ok-2))) base-answer)
(-> (if semantic-ok-0 candidate-0-historical (if semantic-ok-1 candidate-1-historical (switch candidate-2-historical semantic-ok-2))) historical-answer)
(-> (if semantic-ok-0 candidate-0-answer (if semantic-ok-1 candidate-1-answer (switch candidate-2-answer semantic-ok-2))) answer)
(-> (if semantic-ok-0 candidate-0-reply (if semantic-ok-1 candidate-1-reply (switch candidate-2-reply semantic-ok-2))) user-output)
(define execute-outcome
  (if semantic-ok-0 (data:record :status :done :attempts (seq:of semantic-attempt-0))
      (if semantic-ok-1 (data:record :status :done :attempts (seq:of semantic-attempt-0 semantic-attempt-1))
       (data:record :status (if semantic-ok-2 :done :failed) :attempts (seq:of semantic-attempt-0 semantic-attempt-1 semantic-attempt-2)))))
