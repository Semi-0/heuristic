(load-lain "model-refined.lain")
(define request (let-cell [port] port))
(define worker (model))
(-> request (model:input worker))
(define response (model:output worker))
(define policy (let-cell [port] port))
(define target-count (let-cell [port] port))
(define invoice120 (let-cell [port] port))
(define marginal (ttms:ttms-premise-closure (network [n] (if (ttms:<= n 100)
  (ttms:* n 200) (ttms:+ 20000 (ttms:* 150 (ttms:- n 100))))) policy))
(define whole (ttms:ttms-premise-closure (network [n] (if (ttms:<= n 100) (ttms:* n 200) (ttms:* n 150))) policy))
(define flat (ttms:ttms-premise-closure (network [n] (ttms:* n 175)) policy))
(define quote-at-target (network [f] (switch (f target-count) (ttms:= (f 120) invoice120))))
(define marginal-result (quote-at-target marginal))
(define whole-result (quote-at-target whole))
(define flat-result (quote-at-target flat))
(define flat-at-invoice (flat 120))
(define whole-at-invoice (whole 120))
(define marginal-at-invoice (marginal 120))
(define start-value (let-cell [port] port))
(define bind (network [e name ref] (extend-env e (env:reference-slot name ref))))
(define math-env (bind (bind (bind (bind (bind (empty-env) "+" (cell:reference ttms:+))
  "-" (cell:reference ttms:-)) "*" (cell:reference ttms:*)) "/" (cell:reference ttms:divide))
  "start-value" (cell:reference start-value)))
(define math-frame (lexical-child math-env))
(define repair-frame (lexical-child (bind (bind (bind (bind (empty-env) "+" (cell:reference +))
 "*" (cell:reference *)) "-" (cell:reference -)) "<=" (cell:reference <=))))
