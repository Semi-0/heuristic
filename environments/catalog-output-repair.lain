(load-lain "environments/catalog-directed.lain")
(define output-repair-policy "A completed source admission is not proof that the required parent outputs were connected. system-message contains a timestamped admission receipt, the failed source, immediate output edge values/connections, and child bindings. You are repairing the SAME lexical child. All admitted definitions remain installed. Reuse them; do not redefine accepted names or replay their source. Parent outputs have stable unambiguous aliases: parent-discovery-results, parent-selected-id, parent-selection-notes, parent-answer and parent-user-output. If a local definition shadows a parent port, connect the retained local value to the parent alias. Generic example: after a local (define answer (+ x y)) was admitted, (-> answer parent-answer) repairs its missing parent connection. If local user-output is already computed, (-> user-output parent-user-output) connects it. Do not recompute a correct retained result, register the stored callable again, or write hardcoded answers. Required references :first/:second identify the parent ports for this stage, irrespective of local names. Unknown outputs require inspection; known values alone do not prove domain correctness. At most two repairs per stage. Return only complete raw Lain forms, no Markdown fences.")
(define repair-seed (let [e0 (add-binding directed-seed "repair-policy-cell" (cell:reference output-repair-policy))
e1 (add-binding e0 "parent-discovery-results" (cell:reference discovery-results))
e2 (add-binding e1 "parent-selected-id" (cell:reference selected-id))
e3 (add-binding e2 "parent-selection-notes" (cell:reference selection-notes))
e4 (add-binding e3 "parent-answer" (cell:reference answer))
e5 (add-binding e4 "parent-user-output" (cell:reference user-output))
] e5))
(define repair-discover-task "Restore the discovery stage outputs. Connect actual catalog rows to parent-discovery-results. Read system-message and repair-policy-cell. Add only missing connections in this same child. No redefinitions or code fences.")
(define repair-choose-task "Restore the selection stage outputs. Connect the retained selected keyword to parent-selected-id and its notes to parent-selection-notes. Read system-message and repair-policy-cell. Add only missing connections in this same child. No redefinitions or code fences.")
(define repair-execute-task "Restore numeric answer and text reply to parent-answer and parent-user-output. Reuse the already restored callable and any admitted computed local values. Read system-message and repair-policy-cell. Add only missing connections in this same child. No redefinitions or code fences.")
