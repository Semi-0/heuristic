  ;; Avoid constructing a separate higher-order wrapper for every seed slot.
  (let [e0 (empty-env)
        e1 (extend-env e0 (env:reference-slot "generalization-record" (cell:reference generalization-record)))
        e2 (extend-env e1 (env:reference-slot "inspection-feedback" (cell:reference inspection-feedback)))
        e3 (extend-env e2 (env:reference-slot "agent-observations" (cell:reference agent-observations)))
