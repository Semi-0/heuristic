(define model:initial (network [capacity budget] (data:record :version 0 :inputs (queue:empty capacity) :outputs (queue:empty capacity) :history (data:list) :deliveries (data:list) :round (round:initial budget) :serial 0 :context :uninitialized :active :idle :parser (parser:initial) :diagnostic "")))

(define model:prompt (network [history context event] (list:append (data:list (data:record :role "system" :content "Reply with executable Lain source only, without markdown. To reply call (message-to-user \"your reply\"). Use (define name (network [x] ...)) for reusable functions. Never redefine existing names. To request another inference connect a result to a unique slot of model-feedback using (-> result ((slot :unique-name) model-feedback)).")) (list:append history (data:list (data:record :role "user" :content (str "Parent environment: " context "\nRequest: " (data:get :payload event))))))))

(define model:offer (network [state key queue event] (let [offered (queue:offer queue event)] (if (= (data:get :status offered) :accepted) (state:advance state (data:record key (data:get :state offered))) (if (= (data:get :status offered) :duplicate) state (state:advance state (data:record :diagnostic (str "Queue " (data:get :status offered)) :round (round:finish (data:get :round state) true))))))))

(define model:start (network [state event context] (let [round (data:get :round state) prepared (if (= (data:get :kind event) :user) (round:for-user round (data:get :id event)) round)] (if (round:eligible prepared (data:get :count (data:get :inputs state))) (let [serial (+ 1 (data:get :serial state)) history (data:get :history state) request (data:record :id serial :round serial :messages (model:prompt history context event))] (state:advance state (data:record :serial serial :active request :parser (parser:initial) :round (round:start prepared 1) :history (if (= (data:get :kind event) :user) (queue:append-list history (data:record :role "user" :content (data:get :payload event))) history)))) state))))

(define model:step (network [state users events delivered context] (let [inputs (data:get :inputs state) outputs (data:get :outputs state) new-users (queue:unseen users (data:get :history inputs)) new-events (queue:unseen events (data:get :history outputs)) new-deliveries (queue:unseen delivered (data:get :deliveries state))] (if (data:empty? new-events) (if (data:empty? new-users) (if (data:empty? new-deliveries) (if (= (data:get :context state) context) (if (= (data:get :active state) :idle) (if (data:empty? (data:get :pending inputs)) state (model:start state (data:get :car (data:get :pending inputs)) context)) (if (= (data:get :status (data:get :parser state)) :done) (state:advance state (data:record :active :idle :round (round:finish (data:get :round state) false) :inputs (data:get :state (queue:acknowledge inputs (data:get :id (data:get :car (data:get :pending inputs))))))) state)) (if (= (data:get :context state) :uninitialized) (state:advance state (data:record :context context)) (data:with (model:offer state :inputs inputs (data:record :id context :kind :feedback :payload (str context))) (data:record :context context)))) (let [delivery (data:get :car new-deliveries)] (state:advance state (data:record :deliveries (queue:append-list (data:get :deliveries state) delivery) :history (queue:append-list (data:get :history state) (data:record :role "assistant" :content (data:get :payload delivery))))))) (model:offer state :inputs inputs (data:get :car new-users))) (let [event (data:get :car new-events)] (if (= (data:get :kind event) :failure) (state:advance state (data:record :active :idle :round (round:finish (data:get :round state) true) :outputs (data:get :state (queue:offer outputs event)) :diagnostic (data:get :payload event))) (model:offer state :outputs outputs event)))))))

(define model:connect
  (network [model description user-cell]
           (let [state (cell:value (data:get :state-cell model))
                 next (model:step state (cell:value user-cell) (cell:value (data:get :events-cell model))
                                  (cell:value (data:get :delivered-cell model)) (data:snapshot description))]
             (session:feedback (data:get :state-cell model) (data:get :version state) next)
             (transport:request (data:get :transport model) (data:snapshot (data:get :active state)))
             :connected)))
(define actions-of (network [model] model))

;; Model topology and initial values belong here, not in an extension's :cells.
(define model:new
  (network [identity transport capacity budget]
           (define inlet)
           (let [state (source:new (data:with (model:initial capacity budget)
                                              (data:record :model-id identity)))
                 events (source:new (data:list))
                 delivered (source:new (data:list))
                 premise (source:new identity)
                 instance (data:record :state-cell state :inlet (cell:reference inlet)
                                       :events-cell events :delivered-cell delivered
                                       :transport transport :premise premise)]
             (model:connect instance inlet (cell:reference user-input))
             instance)))
