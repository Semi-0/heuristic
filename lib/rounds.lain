;; Scheduling decisions are inspectable Lain values, independent of transport.
(define round:initial
  (network [budget]
    (struct :number 0 :budget budget :busy false :paused false)))
(define round:eligible
  (network [state pending-count]
    (if ((slot :busy) state) false
      (if ((slot :paused) state) false
        (if (< ((slot :number) state) ((slot :budget) state))
          (> pending-count 0) false)))))
(define round:start
  (network [state pending-count]
    (if (round:eligible state pending-count)
      (struct :number (+ 1 ((slot :number) state))
              :budget ((slot :budget) state) :busy true :paused false)
      state)))
(define round:finish
  (network [state transport-failed]
    (struct :number ((slot :number) state) :budget ((slot :budget) state)
            :busy false :paused transport-failed)))
(define round:resume
  (network [state]
    (struct :number ((slot :number) state) :budget ((slot :budget) state)
            :busy ((slot :busy) state) :paused false)))
