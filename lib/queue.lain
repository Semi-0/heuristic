(define queue:append-list
  (network [xs item]
           (if (data:empty? xs) (data:list item)
               (data:cons (data:get :car xs) (queue:append-list (data:get :cdr xs) item)))))

(define queue:contains
  (network [xs id]
           (cond [(data:empty? xs) false
                  (data:equal? (data:get :id (data:get :car xs)) id) true
                  else (queue:contains (data:get :cdr xs) id)])))

(define queue:lookup
  (network [xs id]
           (if (data:equal? (data:get :id (data:get :car xs)) id)
             (data:get :car xs) (queue:lookup (data:get :cdr xs) id))))

;; The numeric comparison is selected only after the type check succeeds.
(define queue:valid-capacity
  (network [capacity]
           (if (data:integer? capacity) (> capacity 0) false)))

(define queue:empty
  (network [capacity]
           (data:record :pending (data:list) :history (data:list) :count 0
                        :capacity capacity :version 0 :valid (queue:valid-capacity capacity))))

(define queue:offer
  (network [state event]
           (let [history (data:get :history state)
                 id (data:get :id event)]
             (cond [(not (queue:valid-capacity (data:get :capacity state)))
                    (data:record :status :invalid-capacity :state state)
                    (queue:contains history id)
                    (if (data:equal? (data:snapshot (queue:lookup history id)) (data:snapshot event))
                      (data:record :status :duplicate :state state)
                      (data:record :status :conflict :state state))
                    (>= (data:get :count state) (data:get :capacity state))
                    (data:record :status :overflow :state state)
                    else
                    (data:record :status :accepted :state
                                 (data:record :pending (queue:append-list (data:get :pending state) event)
                                              :history (queue:append-list history event)
                                              :count (+ 1 (data:get :count state))
                                              :capacity (data:get :capacity state)
                                              :version (+ 1 (data:get :version state))))]))))

(define queue:acknowledge
  (network [state id]
           (cond [(data:empty? (data:get :pending state))
                  (data:record :status :invalid-acknowledgement :state state)
                  (data:equal? (data:get :id (data:get :car (data:get :pending state))) id)
                  (data:record :status :acknowledged :state
                               (data:record :pending (data:get :cdr (data:get :pending state))
                                            :history (data:get :history state)
                                            :count (- (data:get :count state) 1)
                                            :capacity (data:get :capacity state)
                                            :version (+ (data:get :version state) 1)))
                  else (data:record :status :invalid-acknowledgement :state state)])))

(define queue:feedback
  (network [current expected-version next-state]
           (let [current-version (data:get :version current)
                 same (data:equal? current next-state)]
             (cond [(and (= current-version expected-version) same)
                    (data:record :status :unchanged :state current)
                    (and (= current-version expected-version)
                         (= (data:get :version next-state) (+ expected-version 1)))
                    (data:record :status :accepted :state next-state)
                    (= current-version expected-version)
                    (data:record :status :invalid-version :state current)
                    (and (= current-version (+ expected-version 1)) same)
                    (data:record :status :replayed :state current)
                    else (data:record :status :stale-version :state current)]))))

(define queue:unseen
  (network [events history]
           (cond [(data:empty? events) (data:list)
                  (queue:contains history (data:get :id (data:get :car events)))
                  (queue:unseen (data:get :cdr events) history)
                  else events])))
