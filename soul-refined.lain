;; soul-refined — top-down experiment and reviewable specification.
;; Native facilities are supplied through an open-session extension.
;; Loading this file declares topology; invoke experiment separately to start it.
;; Subsequent implementation and acceptance must use this source, not a replica.
(load-primitive-environment "lain_harness/runtime.clj"
  :lain-harness.runtime/primitive-bindings 1)
(load-lain "propagators/compiler_2/runtime/lain/combinator.lain")

;; Native module: src/lain_harness/runtime.clj. Prepare with an explicit owner.
;; Model and user extensions supply their instances independently.
;; Supply these endpoints through the existing open-session extension API:
;; session/session-extension, host/open!, host/extend! and host/extend-source!.
;; session.operators/prim-op builds primitive operators; async-op takes an
;; injected EffectInterpreter and a pure cell-output/effect-output selector.
;; Effects dispatch after commit, via next-round-input or dependency-input.
;; Keep primitive facilities, model session and user input as independent
;; extensions/dependencies with distinct identities, ownership and lifecycles.
;; Connecting them here must not make user publication invoke inference itself.
;; No weather provider or message delivery is installed implicitly.

;; empty-env [] -> environment; lexical-child [parent] -> lexical environment.
;; extend-env [environment contribution] -> extended environment; env:slot
;; [name value] -> binding contribution. Preserve cell identity, lexical capture,
;; support and extension provenance. These are compiler environments, not maps.
;; empty-env is supplied by the native facilities extension.
;; lexical-child is supplied by the native facilities extension.
;; extend-env is supplied by the native facilities extension.
;; env:slot is supplied by the native facilities extension.

;; describe-environment [e] -> connected relevant view of bindings, additions,
;; results and diagnostics. Late additions and retractions update the view.
;; Unknown unrelated fields cannot block available information. Preserve open
;; compound accessors; no frozen list of names or fixed host description schema.
;; describe-environment is supplied by the native facilities extension.

;; incremental-compile [supported-source e] -> admission/result interface.
;; Compile INTO the supplied e, preserving its lexical parent and captures.
;; Use existing atomic CPS/session admission; identity/support prevent duplicate
;; installation. Publish results, diagnostics and provenance into e. Replacement
;; needs explicit version/retraction semantics, not incompatible plain writes.
;; The scoped open-session extension carries target and support-cell explicitly.
;; Each complete streamed form is an atomic monotone admission. A failed form
;; stops that response; earlier admissions remain. Extension cells combine model,
;; round and consumed-input premises using TTMS. Retraction withdraws availability,
;; not topology; finishing a round does not retract its premise.
;; incremental-compile is supplied by the native facilities extension.

;; inputs-of [model-session] -> connected input port; actions-of [model-session]
;; -> supported generated-source publications. Inference sampling, cancellation,
;; obsolete replies, completion and budgets belong to the async effect boundary.
;; A provider snapshot must not sever the upstream connected description.
;; inputs-of is supplied by the native facilities extension.
;; actions-of is supplied by the native facilities extension.

;; Independent supplied instances, not constructors coupled to one another.
;; A model session is supplied by its own extension; user input is a separately
;; supported publication stream, not a field owned by the model adapter.
(define model-session)
(define user-input)
;; message-to-user [recipient] -> output port; weather-at [place date timezone]
;; -> supported observation with source, observed-at and validity information;
;; umbrella-advice [observation] -> advice. IO requires async operators; pure
;; advice uses a primitive operator or a Lain network. None is installed here.
(define message-to-user)
(define weather-at)
(define umbrella-advice)

(define construct-concept-of
  (network [idea content]
    (network [env]
      (extend-env env (env:slot idea content)))))

;; Topology, not scheduling. Both relationships concern the SAME child e.
(define runtime
  (network [environment model]
    (let [e (lexical-child environment)]
      (-> (describe-environment e) (inputs-of model))
      (incremental-compile (actions-of model) e)
      (list e model))))

;; These are Lain environment contributions; the native adapter must not embed
;; a fixed guide/request/capability schema. Paths are a guide index, not a claim
;; that document contents have been loaded. Reading documents is a later supplied
;; capability. Keep source identity/revision visible when contributing contents.
(define language-guide-index
  (list "docs/how-to-think-in-lain.md"
        "docs/how-to-think-in-lain-examples.md"))
(define harness-context
  (struct :source "soul-refined.lain"
          :purpose "Generate useful reusable Lain networks in a lexical child"
          :review-state "implemented; deterministic verification; optional capabilities unresolved"
          :implementation-boundary "Compiler-2 open-session API: prim-op and async-op"))
(define default-environment
  (network [compile-source publish-message guides context]
    (|> (empty-env)
        (construct-concept-of "incremental-compile" compile-source)
        (construct-concept-of "message-to-user" publish-message)
        (construct-concept-of "language-guide-index" guides)
        (construct-concept-of "harness-context" context))))
(define contribute-user-input
  (network [input]
    (construct-concept-of "user-input" input)))
(define weather-environment
  (network [base-env forecast advice]
    (|> base-env
        lexical-child
        (construct-concept-of "weather-at" forecast)
        (construct-concept-of "umbrella-advice" advice))))

;; Assembly stays in Lain. Defining this network does not invoke it.
(define experiment
  (network [model input forecast advice publish-message]
    (let [base (default-environment incremental-compile publish-message
                                    language-guide-index harness-context)
          capable (weather-environment base forecast advice)
          requested ((contribute-user-input input) capable)]
      (runtime requested model))))

;; Request data only: generating the reusable umbrella composition is the task.
;; Resolve tomorrow from explicit request time and timezone, never host now.
(define weather-request-example
  (struct :text "Will I need an umbrella tomorrow in Amsterdam?"
          :requested-at "2026-11-03T12:00:00+01:00"
          :timezone "Europe/Amsterdam"
          :recipient "review-user"))

;; Inspectable implementation contracts; verification is recorded separately.
;; Optional effect endpoints remain pending until explicitly supplied.
(define implementation-obligations
  (list
    (struct :name "lexical-environment" :endpoint lexical-child
            :requires "Native environments, inheritance, contributions and live discovery")
    (struct :name "connected-description" :endpoint describe-environment
            :requires "Relevant bindings, additions, results, diagnostics and support remain connected")
    (struct :name "scoped-compilation" :endpoint incremental-compile
            :requires "Atomic source admission into supplied child; identity, diagnostics and provenance")
    (struct :name "model-interface" :endpoint inputs-of
            :requires "Independent model session; connected inputs/actions; explicit async inference policy")
    (struct :name "user-interface" :endpoint user-input
            :requires "Independent user input dependency and publication lifecycle")
    (struct :name "capability-effects" :endpoint weather-at
            :requires "Independent forecast and message effects; supported observations and receipts")
    (struct :name "native-extension-import"
            :requires "Supply missing bindings through open-session extensions using prim-op and async-op; module supplied by open-session preparation")))
(define acceptance-scenarios
  (list
    "Live updates: publish input, add relevant binding, retract support; existing model input follows without refresh; unrelated unknown does not block"
    "Lexical child: shadow a parent binding, compile generated source into e, verify child capture and no parent/sibling pollution"
    "Generated reuse: model generates umbrella composition; second place uses same definition with fresh forecast inputs"
    "Diagnostic feedback: invalid generated source leaves no partial admission; diagnostics reach existing model input through e"
    "Visible provenance: inspect source identity, extension origin, captured bindings, observation support and effect receipts"
    "Independent extensions: model session and user input can be supplied separately in either order; user updates do not recreate model or compiler session"
    "Effect boundary: pending inputs cause no inference; revisions and obsolete replies obey explicit async policy; replay does not duplicate effects"))
(define experiment-interfaces
  (struct :runtime runtime :assemble experiment
          :empty-environment empty-env :lexical-child lexical-child
          :extend-environment extend-env :binding-contribution env:slot
          :description describe-environment :compile incremental-compile
          :model-inputs inputs-of :model-actions actions-of
          :model-session model-session :user-input user-input
          :message-to-user message-to-user :weather-at weather-at
          :umbrella-advice umbrella-advice))
(define specification
  (struct :entry-point "soul-refined.lain"
          :status "implemented; offline verification; no live model run"
          :interfaces experiment-interfaces
          :obligations implementation-obligations
          :acceptance acceptance-scenarios
          :guides language-guide-index :context harness-context
          :request-example weather-request-example))
specification
