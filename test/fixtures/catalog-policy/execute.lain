(define event-f (cell:value (catalog:resolve :event-cost/v1)))
(define common (event-f quantity unit-price hours hourly-rate surcharge-rate))
(-> common base-answer)
(define historical-f (ttms-premise-closure (ttms-premise-closure (network [amount fee] (+ amount fee)) old-policy) question-old))
(define revised-f (ttms-premise-closure (ttms-premise-closure (network [amount fee rate] (+ amount (* fee (+ 1 rate)))) new-policy) question-current))
(define old-total (historical-f common delivery-charge))
(define new-total (revised-f common delivery-charge surcharge-rate))
(-> old-total historical-answer)
(-> new-total answer)
(-> (str "Total: " new-total) user-output)
