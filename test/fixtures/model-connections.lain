(load-lain "lib/data.lain")
(load-lain "lib/ports.lain")
(load-lain "lib/queue.lain")
(load-lain "lib/rounds.lain")
(load-lain "lib/compiler.lain")
(load-lain "lib/model.lain")
(define test-input)
(define test-context)
(define test-journal (source:new (data:record :version 0 :events (data:list))))
(model:connect-events test-journal :user test-input)
(model:connect-context test-journal test-context)
(define test-previous)
(define test-next)
(model:connect-transition test-journal test-previous test-next)
(define test-request-state)
(define test-recorded-request
  (model:connect-request test-request-state (network [request events] request) :recording-sink))
(define test-source)
(model:connect-events test-journal :source test-source)
