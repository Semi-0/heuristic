(load-lain "lib/behavior-core.lain")
(define source-a (behavior:source))
(define source-b (behavior:source))
(define accumulated (behavior:scan source-a seq:append (seq:empty)))
(define selected (behavior:event-filter accumulated (network [xs] (> (seq:last xs) 1))))
(define latest (behavior:latest-value selected))
(define other (behavior:scan source-b seq:append (seq:empty)))
(define other-latest (behavior:latest-value other))
(define pending-binding)
(define contradictory-binding)
(-> 1 contradictory-binding)
(-> 2 contradictory-binding)
(define inspection-environment
  (extend-env (extend-env (extend-env (empty-env)
    (env:slot "pending" pending-binding))
    (env:slot "conflict" contradictory-binding))
    (env:slot "ready" "available")))
(define overview (environment:overview inspection-environment))
(define inspected (inspect:cell (cell:reference pending-binding)))
(define sibling-a (lexical-child inspection-environment))
(define sibling-b (lexical-child inspection-environment))
(define changing-record)
(define captured (behavior:source))
(-> (event:point (data:get :id changing-record) (data:get :time changing-record) (data:get :value changing-record)) captured)
(define retained-values (behavior:latest-value (behavior:scan captured seq:append (seq:empty))))

(define initial-current (behavior:latest-value accumulated (seq:empty)))
