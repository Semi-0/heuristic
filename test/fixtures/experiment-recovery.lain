(load-lain "soul-refined.lain")
(load-lain "lib/behavior-core.lain")
(load-lain "experiments/phase-orchestration.lain")
(define m (model))
(define worker ((slot :worker) m))
(define raw-model-result (model:output m))
(define model-result (switch raw-model-result (text:prefix? "round-" (data:get :request-id raw-model-result))))
(define request-events (behavior:source))
(define request-input (behavior:latest-value request-events))
(define ask-event)
(define ask (data:get :content ask-event))
(define phase)
(define analysis-record)
(define generalization-record)
(define inspection-feedback)
(define admission-feedback)
(load-lain "environments/repair-guidance.lain")
(define result)
(define context-cell "Extend the persistent child using executable Lain. Inspect failures and unfinished outputs before correcting them.")
(define selected (seq:of "system-message" "repair-policy-cell" "context-cell" "phase" "analysis-record" "generalization-record" "inspection-feedback" "ask"))
(define parent-environment
  (let [a (extend-env (empty-env) (env:reference-slot "context-cell" (cell:reference context-cell)))
        b (extend-env a (env:reference-slot "phase" (cell:reference phase)))
        c (extend-env b (env:reference-slot "analysis-record" (cell:reference analysis-record)))
        d (extend-env c (env:reference-slot "generalization-record" (cell:reference generalization-record)))
        e (extend-env d (env:reference-slot "inspection-feedback" (cell:reference inspection-feedback)))
        f (extend-env e (env:reference-slot "ask" (cell:reference ask)))]
    (extend-env
      (extend-env (extend-env (extend-env f (env:reference-slot "result" (cell:reference result)))
                  (env:reference-slot "system-message" (cell:reference system-message)))
                  (env:reference-slot "repair-details" (cell:reference repair-details)))
      (env:reference-slot "repair-policy-cell" (cell:reference repair-policy-cell)))))
(define runtime-model (struct :input (model:input m) :output model-result))
(define running-runtime (runtime (struct :bindings parent-environment :request request-input) runtime-model))
(define generated-environment (cell:first ((slot :environment) running-runtime)))
(define admission-result ((slot :compilation) running-runtime))
(-> admission-result admission-feedback)
(define required (data:record :production (cell:reference result) :rush (cell:reference result)
                             :discount (cell:reference result) :subtotal (cell:reference result)
                             :delivery (cell:reference result) :tax (cell:reference result)
                             :total (cell:reference result) :reply (cell:reference result)))
(define round-outcome)
(when (data:has? ask-event :content)
  (experiment:question (cell:reference generated-environment) selected worker (cell:reference raw-model-result)
                       (cell:reference admission-result) (cell:reference request-events) (cell:reference repair-detail-events)
                       1 true required ask (cell:reference round-outcome)))
