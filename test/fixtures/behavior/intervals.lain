(load-lain "lib/behavior.lain")
(define input-cell)
(define regions (history input-cell))
(define at-start (sample input-cell 1))
(define at-boundary (sample input-cell 2))
(define outside (sample input-cell 3))
(define held (hold input-cell))
(define held-after (sample held 4))
(define other-input)
(define lifted (lift input-cell other-input +))
(define lifted-scan (scan lifted +))
