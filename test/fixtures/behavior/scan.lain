(load-lain "lib/behavior.lain")
(define input-cell)
(define sums (scan input-cell +))
(define initialized (scan input-cell + 10))
(define append-digit (network [acc next] (+ (* acc 10) next)))
(define digits (scan input-cell append-digit))
(define doubled (map sums (network [x] (* 2 x))))
(define sampled (sample doubled 3))
(define held (hold sums))
(define between (sample held 2.5))
(define filtered (event-filter input-cell (network [x] (> x 1))))
(define filtered-sums (scan filtered +))
(define combined (lift sums doubled +))
(define archived (history sums))
(define reversed (history sums :filo))
(define latest (last sums))
(define mapped-history (history-map sums (network [x] (+ x 100))))
(define other-input)
(define independent (scan other-input +))
