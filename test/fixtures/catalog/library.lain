;; Earlier real-model library, with host-authored example metadata for this seeded experiment.
(define linear-v1 (network [quantity unit-price] (* quantity unit-price)))
(define percentage-v1 (network [amount rate] (* amount (+ 1 rate))))
(define legacy-v1 (network [quantity] (* quantity 2)))
(define max-v1 (network [a b] (if (>= a b) a b)))
(define receipt-linear (catalog:register "{:catalog/id :operator/linear-v1 :catalog/description \"Multiply quantity by unit price\" :catalog/interface \"[quantity unit-price] -> amount\" :catalog/assumptions \"Numeric inputs; compatible units\" :catalog/status :current :catalog/tag [:linear] :catalog/capability [[:catalog/id :cap/linear]] :catalog/example \"For [quantity unit-price], inputs [4 3] produce 12. Example Lain after resolving a callable as f: (f 4 3).\"}" (cell:reference linear-v1)))
(define receipt-percentage (catalog:register "{:catalog/id :operator/percentage-v1 :catalog/description \"Add fractional surcharge to amount\" :catalog/interface \"[amount rate] -> total\" :catalog/assumptions \"Numeric inputs; rate is fractional (e.g. 0.08 for 8%)\" :catalog/status :current :catalog/tag [:percentage] :catalog/capability [[:catalog/id :cap/percentage]] :catalog/example \"For [amount rate], inputs [100 0.08] produce 108. Example Lain after resolving a callable as f: (f 100 0.08).\"}" (cell:reference percentage-v1)))
(define receipt-legacy (catalog:register "{:catalog/id :operator/legacy-v1 :catalog/description \"Legacy quantity charge with fixed unit price 2\" :catalog/interface \"[quantity] -> amount\" :catalog/assumptions \"Numeric input; fixed unit price of 2\" :catalog/status :superseded :catalog/tag [:legacy] :catalog/capability [[:catalog/id :cap/linear]] :catalog/example \"For [quantity], input [4] produces 8 because unit price 2 is captured. This does not accept a variable price.\"}" (cell:reference legacy-v1)))
(define receipt-max (catalog:register "{:catalog/id :operator/max-v1 :catalog/description \"Return numeric maximum of two inputs\" :catalog/interface \"[a b] -> max\" :catalog/assumptions \"Numeric inputs\" :catalog/status :current :catalog/tag [:maximum] :catalog/capability [[:catalog/id :cap/maximum]] :catalog/example \"For [a b], inputs [4 9] produce 9.\"}" (cell:reference max-v1)))
(-> (seq:of receipt-linear receipt-percentage receipt-legacy receipt-max) library-ready)