(load-lain "soul-refined.lain")
(define runtime-test-selection (seq:append (seq:empty) "context"))
(define bindings-a (extend-env (empty-env) (env:slot "context" "alpha")))
(define bindings-b (extend-env (empty-env) (env:slot "context" "beta")))
(define bindings-c (extend-env (empty-env) (env:slot "context" "truncated")))
(define seed-a (struct :bindings bindings-a :request (data:record :id "runtime-a" :text (cell:first (environment:describe bindings-a runtime-test-selection)))))
(define seed-b (struct :bindings bindings-b :request (data:record :id "runtime-b" :text (cell:first (environment:describe bindings-b runtime-test-selection)))))
(define seed-c (struct :bindings bindings-c :request (data:record :id "runtime-c" :text (cell:first (environment:describe bindings-c runtime-test-selection)))))
(define model-a (model))
(define model-b (model))
(define model-c (model))
(define run-a (runtime seed-a model-a))
(define run-b (runtime seed-b model-b))
(define run-c (runtime seed-c model-c))
(define child-a ((slot :environment) run-a))
(define child-b ((slot :environment) run-b))
(define child-c ((slot :environment) run-c))
(define receipt-a ((slot :compilation) run-a))
(define receipt-b ((slot :compilation) run-b))
(define receipt-c ((slot :compilation) run-c))
