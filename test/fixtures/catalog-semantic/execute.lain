(define event-cost-fn (cell:value (catalog:resolve :event-cost/v1)))
(define base-amount (event-cost-fn quantity unit-price hours hourly-rate surcharge-rate))
(-> base-amount base-answer)
(define historical-fn (ttms-premise-closure (ttms-premise-closure (network [base delivery surcharge] (+ base delivery)) old-policy) question-old))
(define historical-amount (historical-fn base-amount delivery-charge surcharge-rate))
(-> historical-amount historical-answer)
(define revised-fn (ttms-premise-closure (ttms-premise-closure (network [base delivery surcharge] (+ base (* delivery surcharge))) new-policy) question-current))
(define revised-amount (revised-fn base-amount delivery-charge surcharge-rate))
(-> revised-amount answer)
(-> (str "Revised Quote: " revised-amount) user-output)